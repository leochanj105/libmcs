t/* ceil, floor, trunc — various exponent ranges */\n4612\tstatic void test_ceil_floor_trunc_round8(void)\n4613\t{\n4614\t    /* ceild.c:68:9:true (j0 < 20), 69:13:true (j0 < 0), 70:17:true (x==0) */\n4615\t    printf(\"ceil 0.0 = %a\\n\", ceil(0.0));\n4616\t    /* ceild.c:70:17:false — x != 0, |x| < 1 */\n4617\t    printf(\"ceil 0.3 = %a\\n\", ceil(0.3));\n4618\t    printf(\"ceil -0.3 = %a\\n\", ceil(-0.3));\n4619\t    /* ceild.c:69:13:false — j0 in [0,19], 86:17:false (has fraction), 92:17:true (i0>0) */\n4620\t    printf(\"ceil 1.5 = %a\\n\", ceil(1.5));\n4621\t    /* ceild.c:92:17:false — negative x in [1, 2^20) */\n4622\t    printf(\"ceil -1.5 = %a\\n\", ceil(-1.5));\n4623\t    /* ceild.c:86:17:true — x is integral in [1, 2^20) */\n4624\t    printf(\"ceil 2.0 = %a\\n\", ceil(2.0));\n4625\t    /* ceild.c:100:13:false — j0 in [20,51]: else branch at line 105 */\n4626\t    /* ceild.c:108:13:true — i1 & i == 0, x is integral */\n4627\t    printf(\"ceil 2097152.0 = %a\\n\", ceil(2097152.0));   /* 2^21 */\n4628\t    /* ceild.c:113:13:false — j0 in [20,51], i0 < 0 */\n4629\t    printf(\"ceil -1048576.5 = %a\\n\", ceil(-1048576.5));\n4630\t    /* ceild.c:114:17:true — j0 == 20 exactly, i0 > 0 */\n4631\t    printf(\"ceil 1048576.5 = %a\\n\", ceil(1048576.5));\n4632\t    /* ceild.c:119:21:false — j0 > 20, no carry (j >= i1) */\n4633\t    printf(\"ceil 3145728.25 = %a\\n\", ceil(3145728.25));\n4634\t\n4635\t    /* floord.c:70:17:true — j0 in [0,19], positive */\n4636\t    printf(\"floor 1.5 = %a\\n\", floor(1.5));\n4637\t    /* floord.c:99:13:false — j0 in [20,51], i1 & i != 0 */\n4638\t    printf(\"floor 1048576.5 = %a\\n\", floor(1048576.5));\n4639\t    /* floord.c:107:13:true — j0 in [20,51], i1 & i == 0 (integral) */\n4640\t    printf(\"floor 2097152.0 = %a\\n\", floor(2097152.0));\n4641\t    /* floord.c:114:17:true — j0 == 20, i0 < 0 */\n4642\t    printf(\"floor -1048576.5 = %a\\n\", floor(-1048576.5));\n4643\t    /* floord.c:119:21:false — j0 > 20, no carry */\n4644\t    printf(\"floor -3145728.25 = %a\\n\", floor(-3145728.25));\n4645\t\n4646\t    /* truncd.c:77:9:true — exponent_less_1023 < 20 */\n4647\t    /* truncd.c:79:13:true — exponent < 0 */\n4648\t    printf(\"trunc 0.3 = %a\\n\", trunc(0.3));\n4649\t    printf(\"trunc -0.3 = %a\\n\", trunc(-0.3));\n4650\t    /* truncd.c:79:13:false — exponent in [0, 19] */\n4651\t    printf(\"trunc 1.7 = %a\\n\", trunc(1.7));\n4652\t    /* truncd.c:86:16:false — exponent in [20, 51] */\n4653\t    printf(\"trunc 1048577.5 = %a\\n\", trunc(1048577.5));\n4654\t    /* truncd.c:87:13:false — exponent > 51, not inf/nan */\n4655\t    printf(\"trunc 1e100 = %a\\n\", trunc(1e100));\n4656\t\n4657\t    /* ceilf branches — same structure as ceild */\n4658\t    printf(\"ceilf 0.0f = %a\\n\", (double)ceilf(0.0f));\n4659\t    printf(\"ceilf 0.3f = %a\\n\", (double)ceilf(0.3f));\n4660\t    printf(\"ceilf -0.3f = %a\\n\", (double)ceilf(-0.3f));\n4661\t    printf(\"ceilf 1.5f = %a\\n\", (double)ceilf(1.5f));\n4662\t    printf(\"ceilf -1.5f = %a\\n\", (double)ceilf(-1.5f));\n4663\t    printf(\"ceilf 2.0f = %a\\n\", (double)ceilf(2.0f));\n4664\t    /* j0 = 13: x in [2^13, 2^14) range */\n4665\t    printf(\"ceilf 8192.5f = %a\\n\", (double)ceilf(8192.5f));\n4666\t    printf(\"ceilf -8192.5f = %a\\n\", (double)ceilf(-8192.5f));\n4667\t    /* ceilf.c:49:13:false — j0 in [0,22], integral */\n4668\t    printf(\"ceilf 8388608.0f = %a\\n\", (double)ceilf(8388608.0f));  /* 2^23 */\n4669\t\n4670\t    /* truncf branches */\n4671\t    printf(\"truncf 0.5f = %a\\n\", (double)truncf(0.5f));\n4672\t    printf(\"truncf -0.5f = %a\\n\", (double)truncf(-0.5f));\n4673\t    printf(\"truncf 1.7f = %a\\n\", (double)truncf(1.7f));\n4674\t    printf(\"truncf 1e20f = %a\\n\", (double)truncf(1e20f));\n4675\t}\n4676\t\n4677\t/* Complex math — ctand, csqrtf, ctanf */\n4678\tstatic void test_complex_round8(void)\n4679\t{\n4680\t    /* ctand.c:102:9:true — d == 0.0: cos(pi) + cosh(0) = -1+1 = 0 */\n4681\t    double complex cz = CMPLX(3.14159265358979323846 / 2.0, 0.0);\n4682\t    double complex cr = ctan(cz);\n4683\t    printf(\"ctan pi/2+0i re = %a\\n\", creal(cr));\n4684\t    printf(\"ctan pi/2+0i im = %a\\n\", cimag(cr));\n4685\t\n4686\t    /* csqrtf.c:44:9:true — fabsf(x) > 4.0: rescale with scale=2 */\n4687\t    float complex fz = CMPLXF(5.0f, 1.0f);\n4688\t    float complex fr = csqrtf(fz);\n4689\t    printf(\"csqrtf 5+1i re = %a\\n\", (double)crealf(fr));\n4690\t    printf(\"csqrtf 5+1i im = %a\\n\", (double)cimagf(fr));\n4691\t\n4692\t    /* Also test large y: fabsf(y) > 4.0 */\n4693\t    float complex fz2 = CMPLXF(1.0f, 5.0f);\n4694\t    float complex fr2 = csqrtf(fz2);\n4695\t    printf(\"csqrtf 1+5i re = %a\\n\", (double)crealf(fr2));\n4696\t    printf(\"csqrtf 1+5i im = %a\\n\", (double)cimagf(fr2));\n4697\t\n4698\t    /* ctanf.c:66:9:true — d == 0.0f */\n4699\t    float complex fz3 = CMPLXF((float)(3.14159265358979323846 / 2.0), 0.0f);\n4700\t    float complex fr3 = ctanf(fz3);\n4701\t    printf(\"ctanf pi/2+0i re = %a\\n\", (double)crealf(fr3));\n4702\t    printf(\"ctanf pi/2+0i im = %a\\n\", (double)cimagf(fr3));\n4703\t}\n4704\t\n4705\t/* fpclassify — NaN with non-zero low word */\n4706\tstatic void test_fpclassify_round8(void)\n4707\t{\n4708\t    /* fpclassifyd.c:72:38:false — msw == 0x7ff00000 but lsw != 0 */\n4709\t    /* Standard NaN: 0x7FF8...0 is quiet, but 0x7FF00...01 is sNaN */\n4710\t    uint64_t nbits = 0x7FF0000000000001ULL;\n4711\t    double nanv;\n4712\t    memcpy(&nanv, &nbits, 8);\n4713\t    printf(\"fpclassify snan-bits = %d\\n\", fpclassify(nanv));\n4714\t}\n4715\t\n4716\t/* jn, yn — x==0, very large x */\n4717\tstatic void test_bessel_round8(void)\n4718\t{\n4719\t    /* jnd.c:122:9:true — (ix|lx)==0 or ix >= 0x7ff00000 */\n4720\t    printf(\"jn 3 0.0 = %a\\n\", jn(3, 0.0));\n4721\t    printf(\"jn 5 0.0 = %a\\n\", jn(5, 0.0));\n4722\t    printf(\"jn 2 inf = %a\\n\", jn(2, 1.0 / 0.0));\n4723\t    /* jnd.c:141:13:true — ix >= 0x52D00000 (x > 2^302) */\n4724\t    printf(\"jn 3 1e91 = %a\\n\", jn(3, 1e91));\n4725\t    /* ynd.c:141:9:true — x == 0 */\n4726\t    printf(\"yn 3 0.0 = %a\\n\", yn(3, 0.0));\n4727\t}\n4728\t\n4729\t/* llrint — zero-result detection */\n4730\tstatic void test_llrint_round8(void)\n4731\t{\n4732\t    /* llrintd.c:101:17:true — high word (sign-cleared) is zero after rounding */\n4733\t    /* llrint(0.5) with round-half-to-even → 0 */\n4734\t    printf(\"llrint 0.5 = %lld\\n\", llrint(0.5));\n4735\t    printf(\"llrint -0.5 = %lld\\n\", llrint(-0.5));\n4736\t    printf(\"llrint 0.0 = %lld\\n\", llrint(0.0));\n4737\t    /* lrintd.c:100:17:true — same for lrint */\n4738\t    printf(\"lrint 0.5 = %ld\\n\", lrint(0.5));\n4739\t}\n4740\t\n4741\t/* remainder, remquo — inf/nan/subnormal inputs */\n4742\tstatic void test_remainder_round8(void)\n4743\t{\n4744\t    /* remainderd.c:118:31:true — hx or hy >= 0x7ff00000 */\n4745\t    printf(\"remainder inf 1.0 = %a\\n\", remainder(1.0 / 0.0, 1.0));\n4746\t    /* remainderd.c:121:20:false — hx >= 0x7ff00000 but not exactly 0x7ff00000 (NaN) */\n4747\t    printf(\"remainder nan 1.0 = %a\\n\", remainder(0.0 / 0.0, 1.0));\n4748\t    /* remainderd.c:132:9:false — hy > 0x7fdfffff (very large y, skip reduction) */\n4749\t    printf(\"remainder 1.0 1e308 = %a\\n\", remainder(1.0, 1e308));\n4750\t    /* remainderd.c:144:13:true — subnormal y, x+x > y */\n4751\t    printf(\"remainder 1e-320 5e-324 = %a\\n\", remainder(1e-320, 5e-324));\n4752\t\n4753\t    /* remainderf.c:36:9:false — hy >= 0x7f800000 (inf y) */\n4754\t    printf(\"remainderf 1.0f inf = %a\\n\", (double)remainderf(1.0f, 1.0f / 0.0f));\n4755\t    /* remainderf.c:48:13:true — subnormal y in float */\n4756\t    printf(\"remainderf 1e-38f 1e-45f = %a\\n\", (double)remainderf(1e-38f, 1e-45f));\n4757\t    /* remainderf.c:51:17 — half-y comparisons */\n4758\t    printf(\"remainderf 2.5f 1.0f = %a\\n\", (double)remainderf(2.5f, 1.0f));\n4759\t}\n4760\t\n4761\t/* atan2f — special cases */\n4762\tstatic void test_atan2f_ro