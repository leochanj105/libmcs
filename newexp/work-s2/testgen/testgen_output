92\t        sl_u.value = (d);                               \\\n293\t        sl_u.parts.lsw = (v);                           \\\n294\t        (d) = sl_u.value;                               \\\n295\t    } while (0 == 1)\n296\t\n297\t/* A union which permits us to convert between a float and a 32 bit\n298\t   int.  */\n299\t\n300\ttypedef union {\n301\t    float value;\n302\t    uint32_t word;\n303\t} ieee_float_shape_type;\n304\t\n305\t/* Get a 32 bit int from a float.  */\n306\t\n307\t#define GET_FLOAT_WORD(i,f)                             \\\n308\t    do {                                                \\\n309\t        ieee_float_shape_type gf_u;                     \\\n310\t        gf_u.value = (f);                               \\\n311\t        (i) = gf_u.word;                                \\\n312\t    } while (0 == 1)\n313\t\n314\t/* Set a float from a 32 bit int.  */\n315\t\n316\t#define SET_FLOAT_WORD(f,i)                             \\\n317\t    do {                                                \\\n318\t        ieee_float_shape_type sf_u;                     \\\n319\t        sf_u.word = (i);                                \\\n320\t        (f) = sf_u.value;                               \\\n321\t    } while (0 == 1)\n322\t\n323\t/* Macros to avoid undefined behaviour that can arise if the amount\n324\t   of a shift is exactly equal to the size of the shifted operand.  */\n325\t\n326\t#define SAFE_RIGHT_SHIFT(op,amt)                        \\\n327\t    (((amt) < 8 * sizeof(op)) ? ((op) >> (amt)) : 0)\n328\t\n329\t/* Exception raising and signaling check functions */\n330\t\n331\tstatic inline double __forced_calculation(double x);\n332\tstatic inline float __forced_calculationf(float x);\n333\t\n334\tstatic inline double __raise_invalid(void);\n335\tstatic inline double __raise_div_by_zero(double x);\n336\tstatic inline double __raise_overflow(double x);\n337\tstatic inline double __raise_underflow(double x);\n338\tstatic inline double __raise_inexact(doub