CS_LONG_DOUBLE_IS_64BITS at once.\n38\t    #endif /* LIBMCS_DOUBLE_IS_32BITS */\n39\t#endif /* LIBMCS_LONG_DOUBLE_IS_64BITS */\n40\t\n41\t/* Most routines need to check whether a float is finite, infinite, or not a\n42\t   number, and many need to know whether the result of an operation will\n43\t   overflow. The macros below wrap up that kind of information:\n44\t\n45\t   FLT_UWORD_IS_FINITE(X)\n46\t    True if a positive float with bitmask X is finite.\n47\t\n48\t   FLT_UWORD_IS_NAN(X)\n49\t    True if a positive float with bitmask X is not a number.\n50\t\n51\t   FLT_UWORD_IS_INFINITE(X)\n52\t    True if a positive float with bitmask X is +infinity.\n53\t\n54\t   FLT_UWORD_MAX\n55\t    The bitmask of FLT_MAX.\n56\t\n57\t   FLT_UWORD_HALF_MAX\n58\t    The bitmask of FLT_MAX/2.\n59\t\n60\t   FLT_UWORD_EXP_MAX\n61\t    The bitmask of the largest finite exponent (129 if the largest\n62\t    exponent is used for finite numbers, 128 otherwise).\n63\t\n64\t   FLT_UWORD_LOG_MAX\n65\t    The bitmask of log(FLT_MAX), rounded down.  This value is the largest\n66\t    input that can be passed to exp() without producing overflow.\n67\t\n68\t   FLT_UWORD_LOG_2MAX\n69\t    The bitmask of log(2*FLT_MAX), rounded down.  This value is the\n70\t    largest input than can be passed to cosh() without producing\n71\t    overflow.\n72\t\n73\t   FLT_LARGEST_EXP\n74\t    The largest biased exponent that can be used for finite numbers\n75\t    (255 if the largest exponent is used for finite numbers, 254\n76\t    otherwise) */\n77\t\n78\t#define FLT_UWORD_IS_FINITE(x) ((x)<0x7f800000L)\n79\t#define FLT_UWORD_IS_NAN(x) ((x)>0x7f800000L)\n80\t#define FLT_UWORD_IS_INFINITE(x) ((x)==0x7f800000L)\n81\t#define FLT_UWORD_MAX 0x7f7fffffL\n82\t#define FLT_UWORD_EXP_MAX 0x43000000\n83\t#define FLT_UWORD_LOG_MAX 0x42b17217\n84\t#define FLT_UWORD_LOG_2MAX 0x42b2d4fc\n85\t#define HUGE ((float)3.40282346638528860e+38)\n86\t#define FLT_UWORD_HALF_MAX (FLT_UWORD_MAX-(1L<<23))\n87\t#define FLT_LARGEST_EXP (FLT_UWORD_MAX>>23)\n88\t\n89\t/* Many routines check for zero and subnormal numbers.  Such things depend\n90\t   on whether the target supports denormals or not:\n91\t\n92\t   FLT_UWORD_IS_ZERO(X)\n93\t    True if a positive float with bitmask X is +0.    Without denormals,\n94\t    any float with a zero exponent is a +0 representation.    With\n95\t    denormals, the only +0 representation is a 0 bitmask.\n96\t\n97\t   FLT_UWORD_IS_SUBNORMAL(X)\n98\t    True if a non-zero positive float with bitmask X is subnormal.\n99\t    (Routines should check for zeros first.)\n100\t\n101\t   FLT_UWORD_MIN\n102\t    The bitmask of the smallest float above +0.  Call this number\n103\t    REAL_FLT_MIN...\n104\t\n105\t   FLT_UWORD_EXP_MIN\n106\t    The bitmask of the float representation of REAL_FLT_MIN's exponent.\n107\t\n108\t   FLT_UWORD_LOG_MIN\n109\t    The bitmask of |log(REAL_FLT_MIN)|, rounding down.\n110\t\n111\t   FLT_SMALLEST_EXP\n112\t    REAL_FLT_MIN's exponent - EXP_BIAS (1 if denormals are not supported,\n113\t    -22 if they are).\n114\t*/\n115\t\n116\t#ifdef __LIBMCS_FPU_DAZ\n117\t    #define FLT_UWORD_IS_ZERO(x) ((x)<0x00800000L)\n118\t    #define FLT_UWORD_IS_SUBNORMAL(x) 0\n119\t    #define FLT_UWORD_MIN 0x00800000\n120\t    #define FLT_UWORD_EXP_MIN 0x42fc0000\n121\t    #define FLT_UWORD_LOG_MIN 0x42aeac50\n122\t    #define FLT_SMALLEST_EXP 1\n123\t#else\n124\t    #define FLT_UWORD_IS_ZERO(x) ((x)==0)\n125\t    #define FLT_UWORD_IS_SUBNORMAL(x) ((x)<0x00800000L)\n126\t    #define FLT_UWORD_MIN 0x00000001\n127\t    #define FLT_UWORD_EXP_MIN 0x43160000\n128\t    #define FLT_UWORD_LOG_MIN 0x42cff1b5\n129\t    #define FLT_SMALLEST_EXP -22\n130\t#endif\n131\t\n132\t#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__\n133\t    #define __IEEE_BIG_ENDIAN\n134\t#elif defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__\n135\t    #define __IEEE_LITTLE_ENDIAN\n136\t#endif\n137\t\n138\t#ifndef __IEEE_BIG_ENDIAN\n139\t    #ifndef __IEEE_L