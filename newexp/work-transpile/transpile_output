56\t * +==============+==============+==============+==============+===================+============+============+===================+==============+==============+\n1257\t * | **log1p(x)** | :math:`qNaN` | :math:`qNaN` | :math:`-Inf` | :math:`ln(1 + x)` | :math:`x`               | :math:`ln(1 + x)` | :math:`+Inf` | :math:`qNaN` |\n1258\t * +--------------+--------------+--------------+--------------+-------------------+------------+------------+-------------------+--------------+--------------+\n1259\t *\n1260\t */\n1261\t\n1262\t/* double log1p(double x)\n1263\t *\n1264\t * Method :\n1265\t *   1. Argument Reduction: find k and f such that\n1266\t *            1+x = 2^k * (1+f),\n1267\t *       where  sqrt(2)/2 < 1+f < sqrt(2) .\n1268\t *\n1269\t *      Note. If k=0, then f=x is exact. However, if k!=0, then f\n1270\t *    may not be representable exactly. In that case, a correction\n1271\t *    term is need. Let u=1+x rounded. Let c = (1+x)-u, then\n1272\t *    log(1+x) - log(u) ~ c/u. Thus, we proceed to compute log(u),\n1273\t *    and add back the correction term c/u.\n1274\t *    (Note: when x > 2**53, one can simply return log(x))\n1275\t *\n1276\t *   2. Approximation of log1p(f).\n1277\t *    Let s = f/(2+f) ; based on log(1+f) = log(1+s) - log(1-s)\n1278\t *         = 2s + 2/3 s**3 + 2/5 s**5 + .....,\n1279\t *              = 2s + s*R\n1280\t *      We use a special Remez algorithm on [0,0.1716] to generate\n1281\t *     a polynomial of degree 14 to approximate R The maximum error\n1282\t *    of this polynomial approximation is bounded by 2**-58.45. In\n1283\t *    other words,\n1284\t *                2      4      6      8      10      12      14\n1285\t *        R(z) ~ Lp1*s +Lp2*s +Lp3*s +Lp4*s +Lp5*s  +Lp6*s  +Lp7*s\n1286\t *      (the values of Lp1 to Lp7 are listed in the program)\n1287\t *    and\n1288\t *        |      2          14          |     -58.45\n1289\t *        | Lp1*s +...+Lp7*s    -  R(z) | <= 2\n1290\t *        |                             |\n1291\t *    Note that 2s = f - s*f = f - hfsq + s*hfsq, where hfsq = f*f/2.\n1292\t *    In order to guarantee error in log below 1ulp, we compute log\n1293\t *    by\n1294\t *        log1p(f) = f - (hfsq - s*(hfsq+R)).\n1295\t *\n1296\t *    3. Finally, log1p(x) = k*ln2 + log1p(f).\n1297\t *                  = k*ln2_hi+(f-(hfsq-(s*(hfsq+R)+k*ln2_lo)))\n1298\t *       Here ln2 is split into two floating point number:\n1299\t *            ln2_hi + ln2_lo,\n1300\t *       where n*ln2_hi is always exact for |n| < 2000.\n1301\t *\n1302\t * Special cases:\n1303\t *    log1p(x) is NaN with signal if x < -1 (including -INF) ;\n1304\t *    log1p(+INF) is +INF; log1p(-1) is -INF with signal;\n1305\t *    log1p(NaN) is that NaN with no signal.\n1306\t *\n1307\t * Accuracy:\n1308\t *    according to an error analysis, the error is always less than\n1309\t *    1 ulp (unit in the last place).\n1310\t *\n1311\t * Constants:\n1312\t * The hexadecimal values are the intended ones for the following\n1313\t * constants. The decimal values may be used, provided that the\n1314\t * compiler will convert from decimal to binary accurately enough\n1315\t * to produce the hexadecimal values shown.\n1316\t *\n1317\t * Note: Assuming log() return accurate answer, the following\n1318\t *      algorithm can be used to compute log1p(x) to within a few ULP:\n1319\t *\n1320\t *        u = 1+x;\n1321\t *        if(u==1.0) return x ; else\n1322\t *               return log(u)*(x/(u-1.0));\n1323\t *\n1324\t *     See HP-15C Advanced Functions Handbook, p.193.\n1325\t */\n1326\t\n1327\t#include <math.h>\n1328\t#include \"../common/tools.h\"\n1329\t#include \"internal/log1pmfd.h\"\n1330\t\n1331\t#ifndef __LIBMCS_DOUBLE_IS_32BITS\n1332\t\n1333\tstatic const double\n1334\tln2_hi  =  6.93147180369123816490e-01,  /* 3fe62e42 fee00000 */\n1335\tln2_lo  =  1.90821492927058770002e-10;  /* 3dea39ef 35793c76 */\n1336\t\n1337\tstatic const double zero = 0.0;\n1338\t\n1339\tdouble log1p(double x)\n1340\t{\n1341\t#ifdef __LIBMCS_FPU_DAZ\n1342\t    x *= __volatile_one;\n1343\t#endif /* defined(__LIBMCS_FPU_DAZ) */\n1344\t\n1345\t    double hfsq, f, c, R, u;\n1346\t    int32_t k, hx, hu, ax;\n1347\t\n1348\t    c = NAN; /* initial value of c is never actually used */\n1349\t    f = NAN; /* initial value of f is never actually used */\n1350\t    hu = INT_MAX; /* initial value of hu is never actually used */\n1351\t\n1352\t    GET_HIGH_WORD(hx, x);\n1353\t    ax = hx & 0x7fffffff;\n1354\t\n1355\t    k = 1;\n1356\t\n1357\t    if (hx >= 0x7ff00000) {                /* x = NaN/+-Inf */\n1358\t        return x + x;\n1359\t    }\n1360\t\n1361\t    if (hx < 0x3FDA827A) {                 /* x < 0.41422  */\n1362\t        if (ax >= 0x3ff00000) {            /* x <= -1.0 */\n1363\t            if (isnan(x)) {\n1364\t                return x + x;\n1365\t            } else if (x == -1.0) {\n1366\t                return __raise_div_by_zero(-1.0); /* log1p(-1)=-inf */\n1367\t            } else {\n1368\t                return __raise_invalid(); /* log1p(x<-1)=NaN */\n1369\t            }\n1370\t        }\n1371\t\n1372\t        if (ax < 0x3e200000) {             /* |x| < 2**-29 */\n1373\t            if (ax < 0x3c900000) {         /* |x| < 2**-54 */\n1374\t                return __raise_inexact(x);\n1375\t            } else {\n1376\t                return __raise_inexact(x - x * x * 0.5);\n1377\t            }\n1378\t        }\n1379\t\n1380\t        if (hx > 0 || hx <= ((int32_t)0xbfd2bec3U)) {\n1381\t            k = 0;\n1382\t            f = x;\n1383\t            hu = 1;\n1384\t        }                                  /* -0.2929<x<0.41422 */\n1385\t    }\n1386\t\n1387\t    if (k != 0) {\n1388\t        if (hx < 0x43400000) {\n1389\t            u  = 1.0 + x;\n1390\t            GET_HIGH_WORD(hu, u);\n1391\t            k  = (hu >> 20) - 1023;\n1392\t            c  = (k > 0) ? 1.0 - (u - x) : x - (u - 1.0); /* correction term */\n1393\t            c /= u;\n1394\t        } else {\n1395\t            u  = x;\n1396\t            GET_HIGH_WORD(hu, u);\n1397\t            k  = (hu >> 20) - 1023;\n1398\t            c  = 0;\n1399\t        }\n1400\t\n1401\t        hu &= 0x000fffff;\n1402\t\n1403\t        if (hu < 0x6a09e) {\n1404\t            SET_HIGH_WORD(u, hu | 0x3ff00000); /* normalize u */\n1405\t        } else {\n1406\t            k += 1;\n1407\t            SET_HIGH_WORD(u, hu | 0x3fe00000); /* normalize u/2 */\n1408\t            hu = (0x00100000 - hu) >> 2;\n1409\t        }\n1410\t\n1411\t        f = u - 1.0;\n1412\t    }\n1413\t\n1414\t    hfsq = 0.5 * f * f;\n1415\t\n1416\t    if (hu == 0) { /* |f| < 2**-20 */\n1417\t        if (f == zero) {\n1418\t            c += k * ln2_lo;\n1419\t            return k * ln2_hi + c;\n1420\t        }\n1421\t\n1422\t        R = hfsq * (1.0 - 0.66666666666666666 * f);\n1423\t\n1424\t        return k * ln2_hi - ((R - (k * ln2_lo + c)) - f);\n1425\t    }\n1426\t\n1427\t    if (k == 0) {\n1428\t        return f - (hfsq - __log1pmf(f));\n1429\t    } else {\n1430\t        return k * ln2_hi - ((hfsq - (__log1pmf(f) + (k * ln2_lo + c))) - f);\n1431\t    }\n1432\t}\n1433\t\n1434\t#ifdef __LIBMCS_LONG_DOUBLE_IS_64BITS\n1435\t\n1436\tlong double log1pl(long double x)\n1437\t{\n1438\t    return (long double) log1p((double) x);\n1439\t}\n1440\t\n1441\t#endif /* #ifdef __LIBMCS_LONG_DOUBLE_IS_64BITS */\n1442\t#endif /* #ifndef __LIBMCS_DOUBLE_IS_32BITS */\n1443\t=== log2d.c ===\n1444\t/* SPDX-License-Identifier: SunMicrosystems */\n1445\t/* Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved. */\n1446\t\n1447\t/**\n1448\t *\n1449\t * This family of functions implements the base :math:`2` logarithm.\n1450\t *\n1451\t * Synopsis\n1452\t * ========\n1453\t *\n1454\t * .. code-block:: c\n1455\t *\n1456\t *     #include <math.h>\n1457\t *     float log2f(float x);\n1458\t *     double log2(double x);\n1459\t *     long double logl(long double x);\n1460\t *\n1461\t * Description\n1462\t * ===========\n1463\t *\n1464\t * ``log2`` computes the base :math:`2` logarithm of the input value.\n1465\t *\n1466\t * Mathematical Function\n1467\t * =====================\n1468\t *\n1469\t * .. math::\n1470\t *\n1471\t *    log2(x) \\approx log_{2}(x)\n1472\t *\n1473\t * Returns\n1474\t * =======\n1475\t *\n1476\t * ``log2`` returns the base :math:`2` logarithm of :math:`x`.\n1477\t *\n1478\t * Exceptions\n1479\t * ==========\n1480\t *\n1481\t * Raise ``invalid operation`` exception when the input value is negative.\n1482\t *\n1483\t * Raise ``divide by zero`` exception when the input value is zero.\n1484\t *\n1485\t * Output map\n1486\t * ==========\n1487\t *\n1488\t * +-------------+--------------+--------------+------------+------------+--------------------+------------+--------------------+--------------+--------------+\n1489\t * | **x**       | :math:`-Inf` | :math:`<0`   | :math:`-0` | :math:`+0` | :math:`]0,1[`      | :math:`1`  | :math:`>1`         | :math:`+Inf` | :math:`NaN`  |\n1490\t * +=============+==============+==============+============+============+====================+============+====================+==============+==============+\n1491\t * | **log2(x)** | :math:`qNaN` | :math:`qNaN` | :math:`-Inf`            | :math:`log_{2}(x)` | :math:`+0` | :math:`log_{2}(x)` | :math:`+Inf` | :math:`qNaN` |\n1492\t * +-------------+--------------+--------------+------------+------------+--------------------+------------+--------------------+--------------+--------------+\n1493\t *\n1494\t */\n1495\t\n1496\t#include <math.h>\n1497\t#include \"../common/tools.h\"\n1498\t#include \"internal/log1pmfd.h\"\n1499\t\n1500\tstatic const double\n1501\ttwo54      =  1.80143985094819840000e+16, /* 0x43500000, 0x00000000 */\n1502\tivln2hi    =  1.44269504072144627571e+00, /* 0x3ff71547, 0x65200000 */\n1503\tivln2lo    =  1.67517131648865118353e-10; /* 0x3de705fc, 0x2eefa200 */\n1504\t\n1505\tstatic const double zero   =  0.0;\n1506\t\n1507\t#ifndef __LIBMCS_DOUBLE_IS_32BITS\n1508\t\n1509\tdouble log2(double x)\n1510\t{\n1511\t#ifdef __LIBMCS_FPU_DAZ\n1512\t    x *= __volatile_one;\n1513\t#endif /* defined(__LIBMCS_FPU_DAZ) */\n1514\t\n1515\t    double f, hfsq, hi, lo, r, val_hi, val_lo, w, y;\n1516\t    int32_t i, k, hx;\n1517\t    uint32_t lx;\n1518\t\n1519\t    EXTRACT_WORDS(hx, lx, x);\n1520\t\n1521\t    k = 0;\n1522\t\n1523\t    if (hx < 0x00100000) {              /* x < 2**-1022  */\n1524\t        if (((hx & 0x7fffffff) | lx) == 0) {\n1525\t            return __raise_div_by_zero(-1.0);     /* log(+-0)=-inf */\n1526\t        }\n1527\t\n1528\t        if (hx < 0) {\n1529\t            if (isnan(x)) {\n1530\t                return x + x;\n1531\t            } else {\n1532\t                return __raise_invalid();   /* log(-#) = NaN */\n1533\t            }\n1534\t        }\n1535\t\n1536\t        k -= 54;\n1537\t        x *= two54;                     /* subnormal number, scale up x */\n1538\t        GET_HIGH_WORD(hx, x);\n1539\t    }\n1540\t\n1541\t    if (hx >= 0x7ff00000) {             /* x = NaN/+-Inf */\n1542\t        return x + x;\n1543\t    }\n1544\t\n1545\t    if (hx == 0x3ff00000 && lx == 0) {  /* log(1) = +0 */\n1546\t        return zero;\n1547\t    }\n1548\t\n1549\t    k += (hx >> 20) - 1023;\n1550\t    hx &= 0x000fffff;\n1551\t    i = (hx + 0x95f64) & 0x100000;\n1552\t    SET_HIGH_WORD(x, hx | (i ^ 0x3ff00000)); /* normalize x or x/2 */\n1553\t    k += (i >> 20);\n1554\t    y = (double)k;\n1555\t    f = x - 1.0;\n1556\t    hfsq = 0.5 * f * f;\n1557\t    r = __log1pmf(f);\n1558\t\n1559\t    /*\n1560\t     * f-hfsq must (for args near 1) be evaluated in extra precision\n1561\t     * to avoid a large cancellation when x is near sqrt(2) or 1/sqrt(2).\n1562\t     * This is fairly efficient since f-hfsq only depends on f, so can\n1563\t     * be evaluated in parallel with R.  Not combining hfsq with R also\n1564\t     * keeps R small (though not as small as a true `lo' term would be),\n1565\t     * so that extra precision is not needed for terms involving R.\n1