{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TXgDmbVrfnaWVPbn8ptuuN","type":"tool_result","content":"1\t/* SPDX-License-Identifier: SunMicrosystems */\n2\t/* Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved. */\n3\t\n4\t/**\n5\t *\n6\t * This family of functions implements the hyperbolic arc tangent of :math:`x`.\n7\t *\n8\t * Synopsis\n9\t * ========\n10\t *\n11\t * .. code-block:: c\n12\t *\n13\t *     #include <math.h>\n14\t *     float atanhf(float x);\n15\t *     double atanh(double x);\n16\t *     long double atanhl(long double x);\n17\t *\n18\t * Description\n19\t * ===========\n20\t *\n21\t * ``atanh`` computes the hyperbolic inverse tangent (*hyperbolic arc tangent*)\n22\t * of the input value.\n23\t *\n24\t * Mathematical Function\n25\t * =====================\n26\t *\n27\t * .. math::\n28\t *\n29\t *    atanh(x) \\approx tanh^{-1}(x) = \\frac{1}{2} ln \\left( \\frac{1+x}{1-x} \\right)\n30\t *\n31\t * Returns\n32\t * =======\n33\t *\n34\t * ``atanh`` returns the hyperbolic inverse tangent.\n35\t *\n36\t * Exceptions\n37\t * ==========\n38\t *\n39\t * Raise ``invalid operation`` exception when the input value is not in the\n40\t * interval :math:`[-1, 1]`.\n41\t *\n42\t * Raise ``divide by zero`` exception when the input value is :math:`-1` or\n43\t * :math:`+1`.\n44\t *\n45\t * .. May raise ``underflow`` exception.\n46\t *\n47\t * Output map\n48\t * ==========\n49\t *\n50\t * +--------------+--------------+--------------+--------------+---------------------+------------+------------+---------------------+--------------+--------------+--------------+--------------+\n51\t * | **x**        | :math:`-Inf` | :math:`<-1`  | :math:`-1`   | :math:`\\in ]-1,-0[` | :math:`-0` | :math:`+0` | :math:`\\in ]+0,+1[` | :math:`+1`   | :math:`>+1`  | :math:`+Inf` | :math:`NaN`  |\n52\t * +==============+==============+==============+==============+=====================+============+============+=====================+==============+==============+==============+==============+\n53\t * | **atanh(x)** | :math:`qNaN` | :math:`qNaN` | :math:`-Inf` | :math:`tanh^{-1} x` | :math:`x`               | :math:`tanh^{-1} x` | :math:`+Inf` | :math:`qNaN` | :math:`qNaN` | :math:`qNaN` |\n54\t * +--------------+--------------+--------------+--------------+---------------------+------------+------------+---------------------+--------------+--------------+--------------+--------------+\n55\t *\n56\t */\n57\t\n58\t#include <math.h>\n59\t#include \"../common/tools.h\"\n60\t\n61\t#ifndef __LIBMCS_DOUBLE_IS_32BITS\n62\t\n63\tstatic const double one = 1.0;\n64\t\n65\tdouble atanh(double x)\n66\t{\n67\t#ifdef __LIBMCS_FPU_DAZ\n68\t    x *= __volatile_one;\n69\t#endif /* defined(__LIBMCS_FPU_DAZ) */\n70\t\n71\t    double t;\n72\t    int32_t hx, ix;\n73\t    uint32_t lx;\n74\t    EXTRACT_WORDS(hx, lx, x);\n75\t    ix = hx & 0x7fffffff;\n76\t\n77\t    if ((ix | ((lx | (-lx)) >> 31)) > 0x3ff00000) { /* |x|>1 */\n78\t        if (isnan(x)) {\n79\t            return x + x;\n80\t        } else {\n81\t            return __raise_invalid();\n82\t        }\n83\t    }\n84\t\n85\t    if (ix == 0x3ff00000) {\n86\t        return __raise_div_by_zero(x);\n87\t    }\n88\t\n89\t    if (ix < 0x3e300000) {     /* x<2**-28 */\n90\t        if (x == 0.0) {        /* return x inexact except 0 */\n91\t            return x;\n92\t        } else {\n93\t            return __raise_inexact(x);\n94\t        }\n95\t    }\n96\t\n97\t    SET_HIGH_WORD(x, ix);\n98\t\n99\t    if (ix < 0x3fe00000) {     /* x < 0.5 */\n100\t        t = x + x;\n101\t        t = 0.5 * log1p(t + t * x / (one - x));\n102\t    } else {\n103\t        t = 0.5 * log1p((x + x) / (one - x));\n104\t    }\n105\t\n106\t    if (hx >= 0) {\n107\t        return t;\n108\t    } else {\n109\t        return -t;\n110\t    }\n111\t}\n112\t#ifdef __LIBMCS_LONG_DOUBLE_IS_64BITS\n113\t\n114\tlong double atanhl(long double x)\n115\t{\n116\t    return (long double) atanh((double) x);\n117\t}\n118