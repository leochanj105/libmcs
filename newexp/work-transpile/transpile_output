{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q9JvymJKmyeGV8tiCNWVj4","type":"tool_result","content":"1\t/* SPDX-License-Identifier: SunMicrosystems */\n2\t/* Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved. */\n3\t\n4\t/*\n5\t * __log1pmf(f):\n6\t * Return log(1+f) - f for 1+f in ~[sqrt(2)/2, sqrt(2)].\n7\t */\n8\t\n9\t#ifndef LIBMCS_LOG1PMFD_H\n10\t#define LIBMCS_LOG1PMFD_H\n11\t\n12\t#ifndef __LIBMCS_DOUBLE_IS_32BITS\n13\t\n14\tstatic const double\n15\tLg1 = 6.666666666666735130e-01,  /* 0x3FE5555555555593 */\n16\tLg2 = 3.999999999940941908e-01,  /* 0x3FD999999997FA04 */\n17\tLg3 = 2.857142874366239149e-01,  /* 0x3FD2492494229359 */\n18\tLg4 = 2.222219843214978396e-01,  /* 0x3FCC71C51D8E78AF */\n19\tLg5 = 1.818357216161805012e-01,  /* 0x3FC7466496CB03DE */\n20\tLg6 = 1.531383769920937332e-01,  /* 0x3FC39A09D078C69F */\n21\tLg7 = 1.479819860511658591e-01;  /* 0x3FC2F112DF3E5244 */\n22\t\n23\t/*\n24\t * We always inline __log1pmf(), since doing so produces a substantial\n25\t * performance improvement (~40% on amd64).\n26\t */\n27\tstatic inline double __log1pmf(double f)\n28\t{\n29\t    double hfsq, s, z, R, w, t1, t2;\n30\t\n31\t    s = f / (2.0 + f);\n32\t    z = s * s;\n33\t    w = z * z;\n34\t    t1 = w * (Lg2 + w * (Lg4 + w * Lg6));\n35\t    t2 = z * (Lg1 + w * (Lg3 + w * (Lg5 + w * Lg7)));\n36\t    R = t2 + t1;\n37\t    hfsq = 0.5 * f * f;\n38\t    return s * (hfsq + R);\n39\t}\n40\t\n41\t#endif /* #ifndef __LIBMCS_DOUBLE_IS_32BITS */\n42\t\n43\t#endif /* !LIBMCS_LOG1PMFD_H */\n44\t\n[result-id: r7]"}]},"parent_tool_use_id":"toolu_011mmtMYWuYsYyyfdxje3npW","session_id":"d923b022-feac-4b63-bc89-51a1cb4c0215","uuid":"77a8a417-5e6c-437f-970d-d491390555ab","timestamp":"2026-04-07T18:19:55.995Z"}
