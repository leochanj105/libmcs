{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BuSPvBDDCTdB8NQS3CKJxZ","type":"tool_result","content":"1\t/* SPDX-License-Identifier: SunMicrosystems */\n2\t/* Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved. */\n3\t/* Conversion to float by Ian Lance Taylor, Cygnus Support, ian@cygnus.com. */\n4\t\n5\t/*\n6\t * fmodf(x,y)\n7\t * Return x mod y in exact arithmetic\n8\t * Method: shift and subtract\n9\t */\n10\t\n11\t#include <math.h>\n12\t#include \"../common/tools.h\"\n13\t\n14\tstatic const float Zero[] = {0.0f, -0.0f,};\n15\t\n16\tfloat fmodf(float x, float y)\n17\t{\n18\t#ifdef __LIBMCS_FPU_DAZ\n19\t    x *= __volatile_onef;\n20\t    y *= __volatile_onef;\n21\t#endif /* defined(__LIBMCS_FPU_DAZ) */\n22\t\n23\t    int32_t n, hx, hy, hz, ix, iy, sx, i;\n24\t\n25\t    GET_FLOAT_WORD(hx, x);\n26\t    GET_FLOAT_WORD(hy, y);\n27\t    sx = hx & 0x80000000U;      /* sign of x */\n28\t    hx ^= sx;                   /* |x| */\n29\t    hy &= 0x7fffffff;           /* |y| */\n30\t\n31\t    /* purge off exception values */\n32\t    if (!FLT_UWORD_IS_FINITE(hx) || !FLT_UWORD_IS_FINITE(hy)) {     /* x or y is +-Inf/NaN */\n33\t        if (FLT_UWORD_IS_INFINITE(hx)) {                            /* x is +-Inf */\n34\t            return __raise_invalidf();\n35\t        } else if (FLT_UWORD_IS_NAN(hx) || FLT_UWORD_IS_NAN(hy)) {  /* x or y is NaN */\n36\t            return x + y;\n37\t        } else {\n38\t            /* No action required */\n39\t        }\n40\t    } else if (FLT_UWORD_IS_ZERO(hy)) {                             /* y is +-0 */\n41\t        return __raise_invalidf();\n42\t    } else {\n43\t        /* No action required */\n44\t    }\n45\t\n46\t    if (hx < hy) {\n47\t        return x;    /* |x|<|y| return x */\n48\t    }\n49\t\n50\t    if (hx == hy) {\n51\t        return Zero[(uint32_t)sx >> 31];    /* |x|=|y| return x*0*/\n52\t    }\n53\t\n54\t    /* Note: y cannot be zero if we reach here. */\n55\t\n56\t    /* determine