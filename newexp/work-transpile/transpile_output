n420\t    y[1] = (ih == 0) ? fw : -fw;\n421\t\n422\t    return n & 7;\n423\t}\n424\t\n425\t/* __rem_pio2(x,y)\n426\t *\n427\t * return the remainder of x rem pi/2 in y[0]+y[1]\n428\t * use __rem_pio2_internal()\n429\t */\n430\t\n431\t/*\n432\t * invpio2:  53 bits of 2/pi\n433\t * pio2_1:   first  33 bit of pi/2\n434\t * pio2_1t:  pi/2 - pio2_1\n435\t * pio2_2:   second 33 bit of pi/2\n436\t * pio2_2t:  pi/2 - (pio2_1+pio2_2)\n437\t * pio2_3:   third  33 bit of pi/2\n438\t * pio2_3t:  pi/2 - (pio2_1+pio2_2+pio2_3)\n439\t */\n440\tstatic const double\n441\thalf     =  5.00000000000000000000e-01, /* 0x3FE00000, 0x00000000 */\n442\tinvpio2  =  6.36619772367581382433e-01, /* 0x3FE45F30, 0x6DC9C883 */\n443\tpio2_1   =  1.57079632673412561417e+00, /* 0x3FF921FB, 0x54400000 */\n444\tpio2_1t  =  6.07710050650619224932e-11, /* 0x3DD0B461, 0x1A626331 */\n445\tpio2_2   =  6.07710050630396597660e-11, /* 0x3DD0B461, 0x1A600000 */\n446\tpio2_2t  =  2.02226624879595063154e-21, /* 0x3BA3198A, 0x2E037073 */\n447\tpio2_3   =  2.02226624871116645580e-21, /* 0x3BA3198A, 0x2E000000 */\n448\tpio2_3t  =  8.47842766036889956997e-32; /* 0x397B839A, 0x252049C1 */\n449\t\n450\tint32_t __rem_pio2(double x, double *y)\n451\t{\n452\t    double z = 0.0, w, t, r, fn;\n453\t    double tx[3];\n454\t    int32_t i, j, n, ix, hx;\n455\t    int32_t e0, nx;\n456\t    uint32_t low;\n457\t\n458\t    GET_HIGH_WORD(hx, x);       /* high word of x */\n459\t    ix = hx & 0x7fffffff;\n460\t\n461\t    if (ix <= 0x3fe921fb) { /* |x| ~<= pi/4 , no need for reduction */\n462\t        y[0] = x;\n463\t        y[1] = 0;\n464\t        return 0;\n465\t    }\n466\t\n467\t    if (ix < 0x4002d97c) { /* |x| < 3pi/4, special case with n=+-1 */\n468\t        if (hx > 0) {\n469\t            z = x - pio2_1;\n470\t\n471\t            if (ix != 0x3ff921fb) {  /* 33+53 bit pi is good enough */\n472\t                y[0] = z - pio2_1t;\n473\t                y[1] = (z - y[0]) - pio2_1t;\n474\t            } else {        /* near pi/2, 