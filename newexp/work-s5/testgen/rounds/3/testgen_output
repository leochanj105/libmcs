.5,  round(0.5));\n    printf(\"round %a = %a\\n\", -0.5, round(-0.5));\n    printf(\"round %a = %a\\n\", 1.5,  round(1.5));\n    printf(\"round %a = %a\\n\", -1.5, round(-1.5));\n    printf(\"round %a = %a\\n\", 2.0,  round(2.0));\n    printf(\"round %a = %a\\n\", 1.0e16, round(1.0e16));\n    printf(\"round %a = %a\\n\", D_INF,  round(D_INF));\n    printf(\"round %a = %a\\n\", 1048576.3, round(1048576.3));\n    printf(\"round %a = %a\\n\", 1048576.7, round(1048576.7));\n    printf(\"roundf %a = %a\\n\", (double)0.5f,  (double)roundf(0.5f));\n    printf(\"roundf %a = %a\\n\", (double)-0.5f, (double)roundf(-0.5f));\n    printf(\"roundf %a = %a\\n\", (double)1.5f,  (double)roundf(1.5f));\n    printf(\"roundf %a = %a\\n\", (double)2.0f,  (double)roundf(2.0f));\n}\n\n/* ---- lrint / lround ---- */\nstatic void test_lrint_extra2(void)\n{\n    printf(\"lrint %a = %ld\\n\", 0.3,  lrint(0.3));\n    printf(\"lrint %a = %ld\\n\", -0.3, lrint(-0.3));\n    printf(\"lrint %a = %ld\\n\", 1.5,  lrint(1.5));\n    printf(\"lrint %a = %ld\\n\", 1048576.5, lrint(1048576.5));\n    /* overflow negative → (140:13) True */\n    printf(\"lrint 1e19 = %ld\\n\",  lrint(1.0e19));\n    printf(\"lrint -1e19 = %ld\\n\", lrint(-1.0e19));\n    printf(\"lrintf %a = %ld\\n\",  (double)0.3f, (long)lrintf(0.3f));\n    printf(\"lrintf %a = %ld\\n\",  (double)1.5f, (long)lrintf(1.5f));\n    printf(\"lrintf 1e10 = %ld\\n\",  (long)lrintf(1.0e10f));\n    printf(\"lrintf -1e10 = %ld\\n\", (long)lrintf(-1.0e10f));\n}\n\nstatic void test_lround_extra2(void)\n{\n    /* exponent in [20,51] → (96:13) False */\n    printf(\"lround %a = %ld\\n\", 1048576.7, lround(1048576.7));\n    printf(\"lround %a = %ld\\n\", 1048576.3, lround(1048576.3));\n    /* carry case */\n    union { double d; uint64_t u; } _lru;\n    _lru.u = 0x41400000c0000001ULL;\n    printf(\"lround carry = %ld\\n\", lround(_lru.d));\n    /* overflow */\n    printf(\"lround 1e19 = %ld\\n\",  lround(1.0e19));\n    printf(\"lround -1e19 = %ld\\n\", lround(-1.0e19));\n    printf(\"lroundf %a = %ld\\n\",   (double)1.5f,  (long)lroundf(1.5f));\n    printf(\"lroundf 1e10 = %ld\\n\", (long)lroundf(1.0e10f));\n    printf(\"lroundf -1e10 = %ld\\n\",(long)lroundf(-1.0e10f));\n}\n\n/* ---- llrint / llround ---- */\nstatic void test_llrint_extra2(void)\n{\n    printf(\"llrint %a = %lld\\n\", 0.3,  llrint(0.3));\n    printf(\"llrint %a = %lld\\n\", -0.3, llrint(-0.3));\n    printf(\"llrint %a = %lld\\n\", 1.5,  llrint(1.5));\n    printf(\"llrint %a = %lld\\n\", 1048576.5, llrint(1048576.5));\n    printf(\"llrint 1e19 = %lld\\n\",  llrint(1.0e19));\n    printf(\"llrint -1e19 = %lld\\n\", llrint(-1.0e19));\n    printf(\"llrintf %a = %lld\\n\",  (double)0.3f,  (long long)llrintf(0.3f));\n    printf(\"llrintf %a = %lld\\n\",  (double)1.5f,  (long long)llrintf(1.5f));\n    printf(\"llrintf 1e10 = %lld\\n\",  (long long)llrintf(1.0e10f));\n    printf(\"llrintf -1e10 = %lld\\n\", (long long)llrintf(-1.0e10f));\n}\n\nstatic void test_llround_extra2(void)\n{\n    /* carry: exponent [20,51], lsw overflows when rounded → (107:17) True */\n    union { double d; uint64_t u; } _llru;\n    _llru.u = 0x41400000c0000001ULL;\n    printf(\"llround carry = %lld\\n\", llround(_llru.d));\n    printf(\"llround %a = %lld\\n\",   1048576.7, llround(1048576.7));\n    /* overflow negative → (118:13) True */\n    printf(\"llround -1e19 = %lld\\n\", llround(-1.0e19));\n    printf(\"llround 1e19 = %lld\\n\",  llround(1.0e19));\n    printf(\"llroundf %a = %lld\\n\",  (double)1.5f,  (long long)llroundf(1.5f));\n    printf(\"llroundf -1e10 = %lld\\n\",(long long)llroundf(-1.0e10f));\n    printf(\"llroundf 1e10 = %lld\\n\", (long long)llroundf(1.0e10f));\n}\n\n/* ---- fmax / fmin ---- */\nstatic void test_fmax_extra2(void)\n{\n    union { double d; uint64_t u; } _snand, _snan2d, _qnand;\n    _snand.u  = 0x7FF0000000000001ULL;\n    _snan2d.u = 0x7FF0000000000002ULL;\n    _qnand.u  = 0x7FF8000000000001ULL;\n    /* isnan(x), at least one signaling → (75:13) True */\n    printf(\"fmax snan snan = %a\\n\", fmax(_snand.d, _snan2d.d));\n    /* isnan(x), x quiet but y signaling → (75:38) True */\n    printf(\"fmax qnan snan = %a\\n\", fmax(_qnand.d, _snand.d));\n    /* isnan(x), neither signaling → (75:13) False */\n    printf(\"fmax qnan 1 = %a\\n\",    fmax(_qnand.d, 1.0));\n    /* isnan(y), y signaling → (85:13) True */\n    printf(\"fmax 1 snan = %a\\n\",    fmax(1.0, _snand.d));\n    /* isnan(y), y quiet → (85:13) False */\n    printf(\"fmax 1 qnan = %a\\n\",    fmax(1.0, _qnand.d));\n    /* no NaN: x > y → (99:12) True */\n    printf(\"fmax 2 1 = %a\\n\",       fmax(2.0, 1.0));\n    /* x <= y → (99:12) False */\n    printf(\"fmax 1 2 = %a\\n\",       fmax(1.0, 2.0));\n    /* fmaxf */\n    union { float f; uint32_t u; } _snanf, _snan2f, _qnanf;\n    _snanf.u  = 0x7F800001U;\n    _snan2f.u = 0x7F800002U;\n    _qnanf.u  = 0x7FC00001U;\n    printf(\"fmaxf snan snan = %a\\n\", (double)fmaxf(_snanf.f, _snan2f.f));\n    printf(\"fmaxf qnan snan = %a\\n\", (double)fmaxf(_qnanf.f, _snanf.f));\n    printf(\"fmaxf qnan 1 = %a\\n\",    (double)fmaxf(_qnanf.f, 1.0f));\n    printf(\"fmaxf 1 snan = %a\\n\",    (double)fmaxf(1.0f, _snanf.f));\n    printf(\"fmaxf 1 qnan = %a\\n\",    (double)fmaxf(1.0f, _qnanf.f));\n    printf(\"fmaxf 2 1 = %a\\n\",       (double)fmaxf(2.0f, 1.0f));\n    printf(\"fmaxf 1 2 = %a\\n\",       (double)fmaxf(1.0f, 2.0f));\n}\n\nstatic void test_fmin_extra2(void)\n{\n    union { double d; uint64_t u; } _snand, _snan2d, _qnand;\n    _snand.u  = 0x7FF0000000000001ULL;\n    _snan2d.u = 0x7FF0000000000002ULL;\n    _qnand.u  = 0x7FF8000000000001ULL;\n    printf(\"fmin snan snan = %a\\n\", fmin(_snand.d, _snan2d.d));\n    printf(\"fmin qnan snan = %a\\n\", fmin(_qnand.d, _snand.d));\n    printf(\"fmin qnan 1 = %a\\n\",    fmin(_qnand.d, 1.0));\n    printf(\"fmin 1 snan = %a\\n\",    fmin(1.0, _snand.d));\n    printf(\"fmin 1 qnan = %a\\n\",    fmin(1.0, _qnand.d));\n    printf(\"fmin 2 1 = %a\\n\",       fmin(2.0, 1.0));\n    printf(\"fmin 1 2 = %a\\n\",       fmin(1.0, 2.0));\n    union { float f; uint32_t u; } _snanf, _snan2f, _qnanf;\n    _snanf.u  = 0x7F800001U;\n    _snan2f.u = 0x7F800002U;\n    _qnanf.u  = 0x7FC00001U;\n    printf(\"fminf snan snan = %a\\n\", (double)fminf(_snanf.f, _snan2f.f));\n    printf(\"fminf qnan snan = %a\\n\", (double)fminf(_qnanf.f, _snanf.f));\n    printf(\"fminf qnan 1 = %a\\n\",    (double)fminf(_qnanf.f, 1.0f));\n    printf(\"fminf 1 snan = %a\\n\",    (double)fminf(1.0f, _snanf.f));\n    printf(\"fminf 1 qnan = %a\\n\",    (double)fminf(1.0f, _qnanf.f));\n    printf(\"fminf 2 1 = %a\\n\",       (double)fminf(2.0f, 1.0f));\n    printf(\"fminf 1 2 = %a\\n\",       (double)fminf(1.0f, 2.0f));\n}\n\n/* ---- fmod ---- */\nstatic void test_fmod_extra2(void)\n{\n    printf(\"fmod 1.5 1 = %a\\n\",      fmod(1.5, 1.0));\n    printf(\"fmod -1.5 1 = %a\\n\",     fmod(-1.5, 1.0));\n    printf(\"fmod 5 3 = %a\\n\",        fmod(5.0, 3.0));\n    printf(\"fmod 1e20 3 = %a\\n\",     fmod(1.0e20, 3.0));\n    printf(\"fmod 1e-5 1e-10 = %a\\n\", fmod(1.0e-5, 1.0e-10));\n    printf(\"fmod 0 1 = %a\\n\",        fmod(0.0, 1.0));\n    printf(\"fmod 1 0 = %a\\n\",        fmod(1.0, 0.0));\n    printf(\"fmod inf 1 = %a\\n\",      fmod(D_INF, 1.0));\n    printf(\"fmod 1 inf = %a\\n\",      fmod(1.0, D_INF));\n    printf(\"fmod 5.5 2.5 = %a\\n\",    fmod(5.5, 2.5));\n    printf(\"fmod 1e-320 5e-324 = %a\\n\", fmod(1.0e-320, 5e-324));\n    printf(\"fmodf 5 3 = %a\\n\",   (double)fmodf(5.0f, 3.0f));\n    printf(\"fmodf -5 3 = %a\\n\",  (double)fmodf(-5.0f, 3.0f));\n    printf(\"fmodf 1e6 7 = %a\\n\", (double)fmodf(1.0e6f, 7.0f));\n    printf(\"fmodf 0 1 = %a\\n\",   (double)fmodf(0.0f, 1.0f));\n    printf(\"fmodf 1 0 = %a\\n\",   (double)fmodf(1.0f, 0.0f));\n    printf(\"fmodf inf 1 = %a\\n\", (double)fmodf(F_INF, 1.0f));\n    printf(\"fmodf 1 inf = %a\\n\", (double)fmodf(1.0f, F_INF));\n}\n\n/* ---- remainder / remquo ---- */\nstatic void test_remainder_extra2(void)\n{\n    printf(\"remainder 5 3 = %a\\n\",   remainder(5.0, 3.0));\n    printf(\"remainder 5 2 = %a\\n\",   remainder(5.0, 2.0));\n    printf(\"remainder -5 3 = %a\\n\",  remainder(-5.0, 3.0));\n    printf(\"remainder 5.5 2 = %a\\n\", remainder(5.5, 2.0));\n    printf(\"remainder 4 2 = %a\\n\",   remainder(4.0, 2.0));\n    /* hy small: subnormal y */\n    printf(\"remainder 1e-300 1e-316 = %a\\n\", remainder(1.0e-300, 1.0e-316));\n    printf(\"remainderf 5 3 = %a\\n\",   (double)remainderf(5.0f, 3.0f));\n    printf(\"remainderf 5 2 = %a\\n\",   (double)remainderf(5.0f, 2.0f));\n    printf(\"remainderf -5 2 = %a\\n\",  (double)remainderf(-5.0f, 2.0f));\n    printf(\"remainderf 4 2 = %a\\n\",   (double)remainderf(4.0f, 2.0f));\n    printf(\"remainderf 1 0 = %a\\n\",   (double)remainderf(1.0f, 0.0f));\n}\n\nstatic void test_remquo_extra2(void)\n{\n    int q;\n    printf(\"remquo 5 3 = %a q=%d\\n\",  remquo(5.0, 3.0, &q), q);\n    printf(\"remquo 5 2 = %a q=%d\\n\",  remquo(5.0, 2.0, &q), q);\n    printf(\"remquo -5 3 = %a q=%d\\n\", remquo(-5.0, 3.0, &q), q);\n    printf(\"remquo 1e-300 1e-316 = %a q=%d\\n\", remquo(1.0e-300, 1.0e-316, &q), q);\n    printf(\"remquof 5 3 = %a q=%d\\n\",  (double)remquof(5.0f, 3.0f, &q), q);\n    printf(\"remquof 5 2 = %a q=%d\\n\",  (double)remquof(5.0f, 2.0f, &q), q);\n    printf(\"remquof -5 3 = %a q=%d\\n\", (double)remquof(-5.0f, 3.0f, &q), q);\n    printf(\"remquof 4 2 = %a q=%d\\n\",  (double)remquof(4.0f, 2.0f, &q), q);\n}\n\n/* ---- sqrt ---- */\nstatic void test_sqrt_extra2(void)\n{\n    /* subnormal with ix1 only (ix0=0) */\n    printf(\"sqrt D_SUBNORM = %a\\n\", sqrt(D_SUBNORM));\n    union { double d; uint64_t u; } _sq;\n    _sq.u = 0x0000000000000001ULL;\n    printf(\"sqrt tiny subnorm = %a\\n\", sqrt(_sq.d));\n    printf(\"sqrt 2 = %a\\n\",   sqrt(2.0));\n    printf(\"sqrt 3 = %a\\n\",   sqrt(3.0));\n    printf(\"sqrt 0.5 = %a\\n\", sqrt(0.5));\n    /* sqrtf */\n    printf(\"sqrtf F_SUBNORM = %a\\n\", (double)sqrtf(F_SUBNORM));\n    union { float f; uint32_t u; } _sqf;\n    _sqf.u = 0x00000001U;\n    printf(\"sqrtf tiny subnorm = %a\\n\", (double)sqrtf(_sqf.f));\n}\n\n/* ---- hypot ---- */\nstatic void test_hypot_extra2(void)\n{\n    /* ha > 2^500, not Inf/NaN → scale down */\n    printf(\"hypot 1e200 1e200 = %a\\n\", hypot(1.0e200, 1.0e200));\n    /* Inf */\n    printf(\"hypot inf 1 = %a\\n\",       hypot(D_INF, 1.0));\n    printf(\"hypot 1 inf = %a\\n\",       hypot(1.0, D_INF));\n    /* hb < 2^-500: b very small */\n    printf(\"hypot 1 1e-320 = %a\\n\",    hypot(1.0, 1.0e-320));\n    printf(\"hypot 1 0 = %a\\n\",         hypot(1.0, 0.0));\n    printf(\"hypot 1e155 1e155 = %a\\n\", hypot(1.0e155, 1.0e155));\n    /* hypotf: large → scale */\n    printf(\"hypotf 1e20 1e20 = %a\\n\",  (double)hypotf(1.0e20f, 1.0e20f));\n    printf(\"hypotf 1e-30 1e-30 = %a\\n\",(double)hypotf(1.0e-30f, 1.0e-30f));\n}\n\n/* ---- sinh / cosh threshold ---- */\nstatic void test_sinh_extra2(void)\n{\n    /* |x| in [22, log(maxdouble)] */\n    printf(\"sinh 22.5 = %a\\n\",  sinh(22.5));\n    printf(\"sinh 709.5 = %a\\n\", sinh(709.5));\n    /* near exact overflow threshold: ix=0x408633CE */\n    union { double d; uint64_t u; } _sh;\n    _sh.u = 0x408633CE8fb9f87dULL;\n    printf(\"sinh at-thresh = %a\\n\", sinh(_sh.d));\n    _sh.u = 0x408633CE8fb9f87eULL;\n    printf(\"sinh above-thresh = %a\\n\", sinh(_sh.d));\n    /* sinhf */\n    printf(\"sinhf 89 = %a\\n\",  (double)sinhf(89.0f));\n    printf(\"sinhf -89 = %a\\n\", (double)sinhf(-89.0f));\n    printf(\"sinhf 10 = %a\\n\",  (double)sinhf(10.0f));\n}\n\nstatic void test_cosh_extra2(void)\n{\n    printf(\"cosh 709.5 = %a\\n\",  cosh(709.5));\n    printf(\"cosh -709.5 = %a\\n\", cosh(-709.5));\n    printf(\"cosh 709.89 = %a\\n\", cosh(709.89));\n    printf(\"cosh 710.5 = %a\\n\",  cosh(710.5));\n    union { double d; uint64_t u; } _ch;\n    _ch.u = 0x408633CE8fb9f87dULL;\n    printf(\"cosh at-thresh = %a\\n\", cosh(_ch.d));\n    _ch.u = 0x408633CE8fb9f87eULL;\n    printf(\"cosh above-thresh = %a\\n\", cosh(_ch.d));\n}\n\n/* ---- log variants ---- */\nstatic void test_log_extra2(void)\n{\n    /* k != 0: x not in (0.5, 2) */\n    printf(\"log 4 = %a\\n\",       log(4.0));\n    printf(\"log 0.1 = %a\\n\",     log(0.1));\n    printf(\"log subnorm = %a\\n\",  log(D_SUBNORM));\n    printf(\"logf 4 = %a\\n\",      (double)logf(4.0f));\n    printf(\"logf 0.1 = %a\\n\",    (double)logf(0.1f));\n    printf(\"logf 0.9 = %a\\n\",    (double)logf(0.9f));\n    printf(\"logf 1.1 = %a\\n\",    (double)logf(1.1f));\n    printf(\"logf subnorm = %a\\n\", (double)logf(F_SUBNORM));\n    /* log10 */\n    printf(\"log10 subnorm = %a\\n\",   log10(D_SUBNORM));\n    printf(\"log10 1e-5 = %a\\n\",      log10(1.0e-5));\n    printf(\"log10f subnorm = %a\\n\",  (double)log10f(F_SUBNORM));\n    printf(\"log10f 1e-5 = %a\\n\",     (double)log10f(1.0e-5f));\n    /* log1p */\n    printf(\"log1p -0.9 = %a\\n\",      log1p(-0.9));\n    printf(\"log1p 1e-20 = %a\\n\",     log1p(1.0e-20));\n    printf(\"log1p 2 = %a\\n\",         log1p(2.0));\n    printf(\"log1pf -0.9 = %a\\n\",     (double)log1pf(-0.9f));\n    printf(\"log1pf 1e-10 = %a\\n\",    (double)log1pf(1.0e-10f));\n    printf(\"log1pf 2 = %a\\n\",        (double)log1pf(2.0f));\n    /* log2 */\n    printf(\"log2 subnorm = %a\\n\",    log2(D_SUBNORM));\n    printf(\"log2 0.5 = %a\\n\",        log2(0.5));\n    printf(\"log2f subnorm = %a\\n\",   (double)log2f(F_SUBNORM));\n    printf(\"log2f 0.5 = %a\\n\",       (double)log2f(0.5f));\n}\n\nstatic void test_logb_extra2(void)\n{\n    /* subnormal with hx==0 (all bits in lx) → (75:17) True */\n    printf(\"logb D_SUBNORM = %a\\n\",  logb(D_SUBNORM));\n    /* subnormal with hx!=0: 2^-1023 → (75:17) False */\n    double _sub2 = 1.1125369292536007e-308;\n    printf(\"logb subnorm-hi = %a\\n\", logb(_sub2));\n    printf(\"logb 1e-308 = %a\\n\",     logb(1.0e-308));\n    printf(\"logb 0 = %a\\n\",          logb(0.0));\n    printf(\"logb 1 = %a\\n\",      