(0x000fffff & hx);\n174\t    } else {      /* subnormal x, shift x to normal */\n175\t        n = -1022 - ix;\n176\t\n177\t        if (n <= 31) {\n178\t            hx = (hx << n) | (lx >> (32 - n));\n179\t            lx <<= n;\n180\t        } else {\n181\t            hx = lx << (n - 32);\n182\t            lx = 0;\n183\t        }\n184\t    }\n185\t\n186\t    if (iy >= -1022) {\n187\t        hy = 0x00100000 | (0x000fffff & hy);\n188\t    } else {      /* subnormal y, shift y to normal */\n189\t        n = -1022 - iy;\n190\t\n191\t        if (n <= 31) {\n192\t            hy = (hy << n) | (ly >> (32 - n));\n193\t            ly <<= n;\n194\t        } else {\n195\t            hy = ly << (n - 32);\n196\t            ly = 0;\n197\t        }\n198\t    }\n199\t\n200\t    /* fix point fmod */\n201\t    n = ix - iy;\n202\t\n203\t    while (n-- > 0) {\n204\t        hz = hx - hy;\n205\t        lz = lx - ly;\n206\t\n207\t        if (lx < ly) {\n208\t            hz -= 1;\n209\t        }\n210\t\n211\t        if (hz < 0) {\n212\t            hx = hx + hx + (lx >> 31);\n213\t            lx = lx + lx;\n214\t        } else {\n215\t            if ((hz | lz) == 0) {  /* return sign(x)*0 */\n216\t                return Zero[(uint32_t)sx >> 31];\n217\t            }\n218\t\n219\t            hx = hz + hz + (lz >> 31);\n220\t            lx = lz + lz;\n221\t        }\n222\t    }\n223\t\n224\t    hz = hx - hy;\n225\t    lz = lx - ly;\n226\t\n227\t    if (lx < ly) {\n228\t        hz -= 1;\n229\t    }\n230\t\n231\t    if (hz >= 0) {\n232\t        hx = hz;\n233\t        lx = lz;\n234\t    }\n235\t\n236\t    /* convert back to floating value and restore the sign */\n237\t    if ((hx | lx) == 0) {      /* return sign(x)*0 */\n238\t        return Zero[(uint32_t)sx >> 31];\n239\t    }\n240\t\n241\t    while (hx < 0x00100000) {     /* normalize x */\n242\t        hx = hx + hx + (lx >> 31);\n243\t        lx = lx + lx;\n244\t        iy -= 1;\n245\t    }\n246\t\n247\t    if (iy >= -1022) {  /* normalize outp