math:`+Inf` | :math:`+Inf` |\n53\t * +--------------------------+              +--------------------------+              +--------------+\n54\t * | :math:`\\in \\mathbb{F}`   |              | :math:`\\sqrt{x^2 + y^2}` |              | :math:`qNaN` |\n55\t * +--------------------------+              +--------------------------+              +--------------+\n56\t * | :math:`+Inf`             |              | :math:`+Inf`             |              | :math:`+Inf` |\n57\t * +--------------------------+              +--------------------------+              +--------------+\n58\t * | :math:`NaN`              |              | :math:`qNaN`             |              | :math:`qNaN` |\n59\t * +--------------------------+--------------+--------------------------+--------------+--------------+\n60\t *\n61\t */\n62\t\n63\t#include <math.h>\n64\t#include \"../common/tools.h\"\n65\t\n66\t#ifndef __LIBMCS_DOUBLE_IS_32BITS\n67\t\n68\tdouble hypot(double x, double y)\n69\t{\n70\t#ifdef __LIBMCS_FPU_DAZ\n71\t    x *= __volatile_one;\n72\t    y *= __volatile_one;\n73\t#endif /* defined(__LIBMCS_FPU_DAZ) */\n74\t\n75\t    double a = x;\n76\t    double b = y;\n77\t    double t1, t2;\n78\t    double _y1, _y2;\n79\t    double w;\n80\t    int32_t j, k, ha, hb;\n81\t\n82\t    GET_HIGH_WORD(ha, x);\n83\t    ha &= 0x7fffffff;\n84\t    GET_HIGH_WORD(hb, y);\n85\t    hb &= 0x7fffffff;\n86\t\n87\t    if (hb > ha) {\n88\t        a = y;\n89\t        b = x;\n90\t        j = ha;\n91\t        ha = hb;\n92\t        hb = j;\n93\t    } else {\n94\t        a = x;\n95\t        b = y;\n96\t    }\n97\t\n98\t    SET_HIGH_WORD(a, ha);         /* a <- |a| */\n99\t    SET_HIGH_WORD(b, hb);         /* b <- |b| */\n100\t\n101\t    if ((ha - hb) > 0x3c00000) {\n102\t        return a + b;             /* x/y > 2**60 */\n103\t    }\n104\t\n105\t    k = 0;\n106\t\n107\t    if (ha > 0x5f300000) {        /* a>2**500 */\n108\t        if (ha >= 0x7ff00000) {   /* Inf or NaN */\n109\t            uint32_t low;\n110\t      