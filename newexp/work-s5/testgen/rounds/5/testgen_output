calbn -1.0 100000 = %a\\n\", scalbn(-1.0, 100000));\n3363\t    /* subnormal x with large positive n → normal result */\n3364\t    printf(\"scalbn 0x1p-1074 2000 = %a\\n\", scalbn(0x1p-1074, 2000));\n3365\t    /* subnormal result */\n3366\t    printf(\"scalbn 1.0 -1074 = %a\\n\", scalbn(1.0, -1074));\n3367\t    /* scalblnd.c:93:13:true - x is ±0 */\n3368\t    printf(\"scalbln 0.0 5L = %a\\n\", scalbln(0.0, 5L));\n3369\t    printf(\"scalbln -0.0 3L = %a\\n\", scalbln(-0.0, 3L));\n3370\t    /* scalblnd.c:92:9:true and 93:13:false - subnormal non-zero */\n3371\t    printf(\"scalbln 0x1p-1074 2L = %a\\n\", scalbln(0x1p-1074, 2L));\n3372\t    printf(\"scalbln 0x1p-1073 3L = %a\\n\", scalbln(0x1p-1073, 3L));\n3373\t    /* scalblnd.c:106:9:true - n > 50000 */\n3374\t    printf(\"scalbln 1.0 100000L = %a\\n\", scalbln(1.0, 100000L));\n3375\t    /* scalblnd.c:116:9:true - n < -50000 */\n3376\t    printf(\"scalbln 1.0 -100000L = %a\\n\", scalbln(1.0, -100000L));\n3377\t    printf(\"scalbln -1.0 -100000L = %a\\n\", scalbln(-1.0, -100000L));\n3378\t}\n3379\t\n3380\tstatic void test_scalbnf_coverage3(void)\n3381\t{\n3382\t    /* scalbnf: x = ±0 */\n3383\t    printf(\"scalbnf 0.0f 5 = %a\\n\", scalbnf(0.0f, 5));\n3384\t    printf(\"scalbnf -0.0f 5 = %a\\n\", scalbnf(-0.0f, 5));\n3385\t    /* scalbnf: n > 50000 overflow */\n3386\t    printf(\"scalbnf 1.0f 100000 = %a\\n\", scalbnf(1.0f, 100000));\n3387\t    /* scalbnf: subnormal x large positive n */\n3388\t    printf(\"scalbnf 0x1p-149f 200 = %a\\n\", scalbnf(0x1p-149f, 200));\n3389\t    /* scalblnf: similar */\n3390\t    printf(\"scalblnf 0.0f 5L = %a\\n\", scalblnf(0.0f, 5L));\n3391\t    printf(\"scalblnf 0x1p-149f 2L = %a\\n\", scalblnf(0x1p-149f, 2L));\n3392\t    printf(\"scalblnf 1.0f 100000L = %a\\n\", scalblnf(1.0f, 100000L));\n3393\t    printf(\"scalblnf 1.0f -100000L = %a\\n\", scalblnf(1.0f, -100000L));\n3394\t    printf(\"scalblnf -1.0f 100000L = %a\\n\", scalblnf(-1.0f, 100000L));\n3395\t}\n3396\t\n3397\t/* modf: integral values and mid-range fraction (j0 in [20,51])       */\n3398\tstatic void test_modf_coverage2(void)\n3399\t{\n3400\t    double ip;\n3401\t    /* modfd.c:88:17:true - x is integral in [1, 2^20) */\n3402\t    printf(\"modf 3.0 = %a int=%a\\n\", modf(3.0, &ip), ip);\n3403\t    printf(\"modf -5.0 = %a int=%a\\n\", modf(-5.0, &ip), ip);\n3404\t    printf(\"modf 2.0 = %a int=%a\\n\", modf(2.0, &ip), ip);\n3405\t    printf(\"modf -2.0 = %a int=%a\\n\", modf(-2.0, &ip), ip);\n3406\t    /* modfd.c:109:13:true - integral in [2^20, 2^52) */\n3407\t    printf(\"modf 2097152.0 = %a int=%a\\n\", modf(2097152.0, &ip), ip);\n3408\t    printf(\"modf -2097152.0 = %a int=%a\\n\", modf(-2097152.0, &ip), ip);\n3409\t    printf(\"modf 1048576.0 = %a int=%a\\n\", modf(1048576.0, &ip), ip);\n3410\t    /* modfd.c:109:13:false and 97:16:false - fractional in [2^20, 2^52) */\n3411\t    printf(\"modf 1048576.5 = %a int=%a\\n\", modf(1048576.5, &ip), ip);\n3412\t    printf(\"modf -1048576.5 = %a int=%a\\n\", modf(-1048576.5, &ip), ip);\n3413\t    printf(\"modf 4194304.75 = %a int=%a\\n\", modf(4194304.75, &ip), ip);\n3414\t}\n3415\t\n3416\tstatic void test_modff_coverage2(void)\n3417\t{\n3418\t    float ip;\n3419\t    /* integral in [1, 2^23) */\n3420\t    printf(\"modff 3.0f = %a int=%a\\n\", modff(3.0f, &ip), ip);\n3421\t    printf(\"modff -5.0f = %a int=%a\\n\", modff(-5.0f, &ip), ip);\n3422\t    printf(\"modff 2.0f = %a int=%a\\n\", modff(2.0f, &ip), ip);\n3423\t    /* float 2^23 boundary */\n3424\t    printf(\"modff 8388608.0f = %a int=%a\\n\", modff(8388608.0f, &ip), ip);\n3425\t    printf(\"modff 8388608.5f = %a int=%a\\n\", modff(8388608.5f, &ip), ip);\n3426\t    printf(\"modff -8388608.5f = %a int=%a\\n\", modff(-8388608.5f, &ip), ip);\n3427\t}\n3428\t\n3429\t/* nextafter: ±zero pair, same-exponent, and overflow                 */\n3430\tstatic void test_nextafter_coverage2(void)\n3431\t{\n3432\t    /* nextafterd.c:95:13:true - x=+0, y=-0 → returns -0 */\n3433\t    printf(\"nextaft