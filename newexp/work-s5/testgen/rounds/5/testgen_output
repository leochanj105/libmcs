intf(\"floor %a = %a\\n\", 0.5,  floor(0.5));\n    printf(\"floor %a = %a\\n\", -0.5, floor(-0.5));\n    printf(\"floor %a = %a\\n\", 2.0,  floor(2.0));\n    printf(\"floor %a = %a\\n\", 1.5,  floor(1.5));\n    printf(\"floor %a = %a\\n\", -1.5, floor(-1.5));\n    printf(\"floor %a = %a\\n\", -1.75, floor(-1.75));\n    printf(\"floor %a = %a\\n\", 1.0e16, floor(1.0e16));\n    printf(\"floor %a = %a\\n\", D_INF,  floor(D_INF));\n    printf(\"floor %a = %a\\n\", 1048576.0,  floor(1048576.0));\n    printf(\"floor %a = %a\\n\", 1048576.5,  floor(1048576.5));\n    printf(\"floor %a = %a\\n\", -1048576.5, floor(-1048576.5));\n    printf(\"floor %a = %a\\n\", 2097152.5,  floor(2097152.5));\n    /* negative, j0=21, carry: hx<0, _i1 has bit 31 set */\n    union { double d; uint64_t u; } _fu;\n    _fu.u = 0xC1400000c0000001ULL;\n    printf(\"floor carry neg = %a\\n\", floor(_fu.d));\n}\n\nstatic void test_floorf_extra2(void)\n{\n    printf(\"floorf %a = %a\\n\", (double)0.5f,      (double)floorf(0.5f));\n    printf(\"floorf %a = %a\\n\", (double)-0.5f,     (double)floorf(-0.5f));\n    printf(\"floorf %a = %a\\n\", (double)1.5f,      (double)floorf(1.5f));\n    printf(\"floorf %a = %a\\n\", (double)-1.5f,     (double)floorf(-1.5f));\n    printf(\"floorf %a = %a\\n\", (double)2.0f,      (double)floorf(2.0f));\n    printf(\"floorf %a = %a\\n\", (double)1.0e7f,    (double)floorf(1.0e7f));\n    printf(\"floorf %a = %a\\n\", (double)8388607.5f,(double)floorf(8388607.5f));\n    printf(\"floorf %a = %a\\n\", (double)F_INF,     (double)floorf(F_INF));\n}\n\n/* ---- trunc ---- */\nstatic void test_trunc_extra2(void)\n{\n    printf(\"trunc %a = %a\\n\", 0.5,    trunc(0.5));\n    printf(\"trunc %a = %a\\n\", -0.5,   trunc(-0.5));\n    printf(\"trunc %a = %a\\n\", 1.5,    trunc(1.5));\n    printf(\"trunc %a = %a\\n\", -1.5,   trunc(-1.5));\n    printf(\"trunc %a = %a\\n\", 1.0e16, trunc(1.0e16));\n    printf(\"trunc %a = %a\\n\", D_INF,  trunc(D_INF));\n    printf(\"trunc %a = %a\\n\", D_NAN,  trunc(D_NAN));\n    printf(\"trunc %a = %a\\n\", 1048576.5,  trunc(1048576.5));\n    printf(\"trunc %a = %a\\n\", -1048576.5, trunc(-1048576.5));\n}\n\nstatic void test_truncf_extra2(void)\n{\n    printf(\"truncf %a = %a\\n\", (double)0.5f,   (double)truncf(0.5f));\n    printf(\"truncf %a = %a\\n\", (double)-0.5f,  (double)truncf(-0.5f));\n    printf(\"truncf %a = %a\\n\", (double)1.5f,   (double)truncf(1.5f));\n    printf(\"truncf %a = %a\\n\", (double)-1.5f,  (double)truncf(-1.5f));\n    printf(\"truncf %a = %a\\n\", (double)1.0e7f, (double)truncf(1.0e7f));\n    printf(\"truncf %a = %a\\n\", (double)F_INF,  (double)truncf(F_INF));\n    printf(\"truncf %a = %a\\n\", (double)F_NAN,  (double)truncf(F_NAN));\n}\n\n/* ---- modf ---- */\nstatic void test_modf_extra2(void)\n{\n    double ip;\n    float fip;\n    printf(\"modf %a = %a ip=%a\\n\", 0.5,    modf(0.5, &ip),    ip);\n    printf(\"modf %a = %a ip=%a\\n\", -0.5,   modf(-0.5, &ip),   ip);\n    printf(\"modf %a = %a ip=%a\\n\", 2.0,    modf(2.0, &ip),    ip);\n    printf(\"modf %a = %a ip=%a\\n\", 1.5,    modf(1.5, &ip),    ip);\n    printf(\"modf %a = %a ip=%a\\n\", 1.0e16, modf(1.0e16, &ip), ip);\n    printf(\"modf %a = %a ip=%a\\n\", D_NAN,  modf(D_NAN, &ip),  ip);\n    printf(\"modf %a = %a ip=%a\\n\", 1048576.0, modf(1048576.0, &ip), ip);\n    printf(\"modf %a = %a ip=%a\\n\", 1048576.5, modf(1048576.5, &ip), ip);\n    printf(\"modff %a = %a ip=%a\\n\", (double)0.5f,   (double)modff(0.5f,   &fip), (double)fip);\n    printf(\"modff %a = %a ip=%a\\n\", (double)-0.5f,  (double)modff(-0.5f,  &fip), (double)fip);\n    printf(\"modff %a = %a ip=%a\\n\", (double)2.0f,   (double)modff(2.0f,   &fip), (double)fip);\n    printf(\"modff %a = %a ip=%a\\n\", (double)1.5f,   (double)modff(1.5f,   &fip), (double)fip);\n    printf(\"modff %a = %a ip=%a\\n\", (double)3.0f,   (double)modff(3.0f,   &fip), (double)fip);\n    printf(\"modff %a = %a ip=%a\\n\", (double)F_NAN,  (double)modff(F_NAN,  &fip), (double)fip);\n    printf(\"modff %a = %a ip=%a\\n\", (double)1.0e7f, (double)modff(1.0e7f, &fip), (double)fip);\n}\n\n/* ---- frexp ---- */\nstatic void test_frexp_extra2(void)\n{\n    int e;\n    double r;\n    float rf;\n    /* subnormal with lx only (hx=0): D_SUBNORM → (84:5) True, (85:8) True */\n    r = frexp(D_SUBNORM, &e);\n    printf(\"frexp D_SUBNORM = %a exp=%d\\n\", r, e);\n    /* subnormal with hx!=0: 2^-1023, hx=0x00080000 */\n    double _sub2 = 1.1125369292536007e-308;\n    r = frexp(_sub2, &e);\n    printf(\"frexp subnorm-hi = %a exp=%d\\n\", r, e);\n    /* normal → (84:5) False */\n    r = frexp(1.5, &e);\n    printf(\"frexp 1.5 = %a exp=%d\\n\", r, e);\n    /* frexpf: subnormal */\n    rf = frexpf(F_SUBNORM, &e);\n    printf(\"frexpf F_SUBNORM = %a exp=%d\\n\", (double)rf, e);\n    rf = frexpf(1.5f, &e);\n    printf(\"frexpf 1.5 = %a exp=%d\\n\", (double)rf, e);\n    /* subnormal float with hx!=0: exponent=0, mantissa high bit set */\n    union { float f; uint32_t u; } _sf2;\n    _sf2.u = 0x00400000U;\n    rf = frexpf(_sf2.f, &e);\n    printf(\"frexpf subnorm-hi = %a exp=%d\\n\", (double)rf, e);\n}\n\n/* ---- nextafter ---- */\nstatic void test_nextafter_extra2(void)\n{\n    /* x==0 paths */\n    printf(\"nextafter 0 1 = %a\\n\",  nextafter(0.0, 1.0));\n    printf(\"nextafter 0 -1 = %a\\n\", nextafter(0.0, -1.0));\n    /* x>0, x>y */\n    printf(\"nextafter 2 1 = %a\\n\",  nextafter(2.0, 1.0));\n    /* x>0, x<y */\n    printf(\"nextafter 1 2 = %a\\n\",  nextafter(1.0, 2.0));\n    /* x<0 paths */\n    printf(\"nextafter -1 0 = %a\\n\",  nextafter(-1.0, 0.0));\n    printf(\"nextafter -1 -2 = %a\\n\", nextafter(-1.0, -2.0));\n    printf(\"nextafter -2 -1 = %a\\n\", nextafter(-2.0, -1.0));\n    /* overflow: max double toward +inf */\n    printf(\"nextafter max +inf = %a\\n\",\n           nextafter(1.7976931348623157e308, D_INF));\n    /* nextafterf */\n    printf(\"nextafterf 0 1 = %a\\n\",   (double)nextafterf(0.0f, 1.0f));\n    printf(\"nextafterf 0 -1 = %a\\n\",  (double)nextafterf(0.0f, -1.0f));\n    printf(\"nextafterf 2 1 = %a\\n\",   (double)nextafterf(2.0f, 1.0f));\n    printf(\"nextafterf -1 0 = %a\\n\",  (double)nextafterf(-1.0f, 0.0f));\n    printf(\"nextafterf -1 -2 = %a\\n\", (double)nextafterf(-1.0f, -2.0f));\n    printf(\"nextafterf max +inf = %a\\n\",\n           (double)nextafterf(3.4028235e38f, F_INF));\n}\n\n/* ---- scalbn / scalbln ---- */\nstatic void test_scalbn_extra2(void)\n{\n    printf(\"scalbn 1 50001 = %a\\n\",  scalbn(1.0, 50001));\n    printf(\"scalbn 1 -50001 = %a\\n\", scalbn(1.0, -50001));\n    printf(\"scalbn 2 1024 = %a\\n\",   scalbn(2.0, 1024));\n    printf(\"scalbn 2 -1075 = %a\\n\",  scalbn(2.0, -1075));\n    printf(\"scalbnf 1 50001 = %a\\n\",  (double)scalbnf(1.0f, 50001));\n    printf(\"scalbnf 1 -50001 = %a\\n\", (double)scalbnf(1.0f, -50001));\n    printf(\"scalbnf 2 200 = %a\\n\",    (double)scalbnf(2.0f, 200));\n    printf(\"scalbnf 2 -200 = %a\\n\",   (double)scalbnf(2.0f, -200));\n}\n\nstatic void test_scalbln_extra2(void)\n{\n    printf(\"scalbln 1 50001 = %a\\n\",   scalbln(1.0, 50001L));\n    printf(\"scalbln 1 -50001 = %a\\n\",  scalbln(1.0, -50001L));\n    printf(\"scalbln 2 1024 = %a\\n\",    scalbln(2.0, 1024L));\n    printf(\"scalbln 2 -1075 = %a\\n\",   scalbln(2.0, -1075L));\n    printf(\"scalblnf 1 50001 = %a\\n\",  (double)scalblnf(1.0f, 50001L));\n    printf(\"scalblnf 1 -50001 = %a\\n\", (double)scalblnf(1.0f, -50001L));\n    printf(\"scalblnf 2 200 = %a\\n\",    (double)scalblnf(2.0f, 200L));\n    printf(\"scalblnf 2 -200 = %a\\n\",   (double)scalblnf(2.0f, -200L));\n}\n\n/* ---- rint ---- */\nstatic void test_rint_extra2(void)\n{\n    /* j0 < 0: |x| < 0.5 */\n    printf(\"rint %a = %a\\n\", 0.3,  rint(0.3));\n    printf(\"rint %a = %a\\n\", -0.3, rint(-0.3));\n    /* j0 in [0,20): 2nd bit after radix set → (99:17) True */\n    printf(\"rint %a = %a\\n\", 1.75, rint(1.75));\n    printf(\"rint %a = %a\\n\", 1.5,  rint(1.5));\n    printf(\"rint %a = %a\\n\", 2.0,  rint(2.0));\n    /* j0 == 19: → (101:21) True */\n    printf(\"rint %a = %a\\n\", 524288.1,  rint(524288.1));\n    printf(\"rint %a = %a\\n\", -524288.1, rint(-524288.1));\n    /* j0 > 51 */\n    printf(\"rint %a = %a\\n\", 1.0e16, rint(1.0e16));\n    printf(\"rint %a = %a\\n\", D_INF,  rint(D_INF));\n    /* j0 in [20,51]: integral → (119:13) True */\n    printf(\"rint %a = %a\\n\", 1048576.0, rint(1048576.0));\n    /* j0 in [20,51]: non-integral, 2nd bit → (125:13) True */\n    printf(\"rint %a = %a\\n\", 1048576.75, rint(1048576.75));\n    printf(\"rint %a = %a\\n\", 1048576.5,  rint(1048576.5));\n    /* rintf */\n    printf(\"rintf %a = %a\\n\", (double)0.3f,       (double)rintf(0.3f));\n    printf(\"rintf %a = %a\\n\", (double)1.75f,      (double)rintf(1.75f));\n    printf(\"rintf %a = %a\\n\", (double)1.0e7f,     (double)rintf(1.0e7f));\n    printf(\"rintf %a = %a\\n\", (double)8388608.5f, (double)rintf(8388608.5f));\n}\n\n/* ---- round ---- */\nstatic void test_round_extra2(void)\n{\n    printf(\"round %a = %a\\n\", 0.4,  round(0.4));\n    printf(\"round %a = %a\\n\", 0.5,  round(0.5));\n    printf(\"round %a = %a\\n\", -0.5, round(-0.5));\n    printf(\"round %a = %a\\n\", 1.5,  round(1.5));\n    printf(\"round %a = %a\\n\", -1.5, round(-1.5));\n    printf(\"round %a = %a\\n\", 2.0,  round(2.0));\n    printf(\"round %a = %a\\n\", 1.0e16, round(1.0e16));\n    printf(\"round %a = %a\\n\", D_INF,  round(D_INF));\n    printf(\"round %a = %a\\n\", 1048576.3, round(1048576.3));\n    printf(\"round %a = %a\\n\", 1048576.7, round(1048576.7));\n    printf(\"roundf %a = %a\\n\", (double)0.5f,  (double)roundf(0.5f));\n    printf(\"roundf %a = %a\\n\", (double)-0.5f, (double)roundf(-0.5f));\n    printf(\"roundf %a = %a\\n\", (double)1.5f,  (double)roundf(1.5f));\n    printf(\"roundf %a = %a\\n\", (double)2.0f,  (double)roundf(2.0f));\n}\n\n/* ---- lrint / lround ---- */\nstatic void test_lrint_extra2(void)\n{\n    printf(\"lrint %a = %ld\\n\", 0.3,  lrint(0.3));\n    printf(\"lrint %a = %ld\\n\", -0.3, lrint(-0.3));\n    printf(\"lrint %a = %ld\\n\", 1.5,  lrint(1.5));\n    printf(\"lrint %a = %ld\\n\", 1048576.5, lrint(1048576.5));\n    /* overflow negative → (140:13) True */\n    printf(\"lrint 1e19 = %ld\\n\",  lrint(1.0e19));\n    printf(\"lrint -1e19 = %ld\\n\", lrint(-1.0e19));\n    printf(\"lrintf %a = %ld\\n\",  (double)0.3f, (long)lrintf(0.3f));\n    printf(\"lrintf %a = %ld\\n\",  (double)1.5f, (long)lrintf(1.5f));\n    printf(\"lrintf 1e10 = %ld\\n\",  (long)lrintf(1.0e10f));\n    printf(\"lrintf -1e10 = %ld\\n\", (long)lrintf(-1.0e10f));\n}\n\nstatic void test_lround_extra2(void)\n{\n    /* exponent in [20,51] → (96:13) False */\n    printf(\"lround %a = %ld\\n\", 1048576.7, lround(1048576.7));\n    printf(\"lround %a = %ld\\n\", 1048576.3, lround(1048576.3));\n    /* carry case */\n    union { double d; uint64_t u; } _lru;\n    _lru.u = 0x41400000c0000001ULL;\n    printf(\"lround carry = %ld\\n\", lround(_lru.d));\n    /* overflow */\n    printf(\"lround 1e19 = %ld\\n\",  lround(1.0e19));\n    printf(\"lround -1e19 = %ld\\n\", lround(-1.0e19));\n    printf(\"lroundf %a = %ld\\n\",   (double)1.5f,  (long)lroundf(1.5f));\n    printf(\"lroundf 1e10 = %ld\\n\", (long)lroundf(1.0e10f));\n    printf(\"lroundf -1e10 = %ld\\n\",(long)lroundf(-1.0e10f));\n}\n\n/* ---- llrint / llround ---- */\nstatic void test_llrint_extra2(void)\n{\n    printf(\"llrint %a = %lld\\n\", 0.3,  llrint(0.3));\n    printf(\"llrint %a = %lld\\n\", -0.3, llrint(-0.3));\n    printf(\"llrint %a = %lld\\n\", 1.5,  llrint(1.5));\n    printf(\"llrint %a = %lld\\n\", 1048576.5, llrint(1048576.5));\n    printf(\"llrint 1e19 = %lld\\n\",  llrint(1.0e19));\n    printf(\"llrint -1e19 = %lld\\n\", llrint(-1.0e19));\n    printf(\"llrintf %a = %lld\\n\",  (double)0.3f,  (long long)llrintf(0.3f));\n    printf(\"llrintf %a = %lld\\n\",  (double)1.5f,  (long long)llrintf(1.5f));\n    printf(\"llrintf 1e10 = %lld\\n\",  (long long)llrintf(1.0e10f));\n    printf(\"llrintf -1e10 = %lld\\n\", (long long)llrintf(-1.0e10f));\n}\n\nstatic void test_llround_extra2(void)\n{\n    /* carry: exponent [20,51], lsw overflows when rounded → (107:17) True */\n    union { double d; uint64_t u; } _llru;\n    _llru.u = 0x41400000c0000001ULL;\n    printf(\"llround carry = %lld\\n\", llround(_llru.d));\n    printf(\"llround %a = %lld\\n\",   1048576.7, llround(1048576.7));\n    /* overflow negative → (118:13) True */\n    printf(\"llround -1e19 = %lld\\n\", llround(-1.0e19));\n    printf(\"llround 1e19 = %lld\\n\",  llround(1.0e19));\n    printf(\"llroundf %a = %lld\\n\",  (double)1.5f,  (long long)llroundf(1.5f));\n    printf(\"llroundf -1e10 = %lld\\n\",(long long)llroundf(-1.0e10f));\n    printf(\"llroundf 1e10 = %lld\\n\", (long long)llroundf(1.0e10f));\n}\n\n/* ---- fmax / fmin ---- */\nstatic void test_fmax_extra2(void)\n{\n    union { double d; uint64_t u; } _snand, _snan2d, _qnand;\n    _snand.u  = 0x7FF0000000000001ULL;\n    _snan2d.u = 0x7FF0000000000002ULL;\n    _qnand.u  = 0x7FF8000000000001ULL;\n    /* isnan(x), at least one signaling → (75:13) True */\n    printf(\"fmax snan snan = %a\\n\", fmax(_snand.d, _snan2d.d));\n    /* isnan(x), x quiet but y signaling → (75:38) True */\n    printf(\"fmax qnan snan = %a\\n\", fmax(_qnand.d, _snand.d));\n    /* isnan(x), neither signaling → (75:13) False */\n    printf(\"fmax qnan 1 = %a\\n\",    fmax(_qnand.d, 1.0));\n    /* isnan(y), y signaling → (85:13) True */\n    printf(\"fmax 1 snan = %a\\n\",    fmax(1.0, _snand.d));\n    /* isnan(y), y quiet → (85:13) False */\n    printf(\"fmax 1 qnan = %a\\n\",    fmax(1.0, _qnand.d));\n    /* no NaN: x > y → (99:12) True */\n    printf(\"fmax 2 1 = %a\\n\",       fmax(2.0, 1.0));\n    /* x <= y → (99:12) False */\n    printf(\"fmax 1 2 = %a\\n\",       fmax(1.0, 2.0));\n    /* fmaxf */\n    union { float f; uint32_t u; } _snanf, _snan2f, _qnanf;\n    _snanf.u  = 0x7F800001U;\n    _snan2f.u = 0x7F800002U;\n    _qnanf.u  = 0x7FC00001U;\n    printf(\"fmaxf snan