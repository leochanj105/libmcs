",    (double)lgammaf(3.0f));\n    printf(\"lgammaf 4.0 = %a\\n\",    (double)lgammaf(4.0f));\n    printf(\"lgammaf 7.0 = %a\\n\",    (double)lgammaf(7.0f));\n    printf(\"lgammaf 8.0 = %a\\n\",    (double)lgammaf(8.0f));\n    printf(\"lgammaf -4.5 = %a\\n\",   (double)lgammaf(-4.5f));\n    printf(\"lgammaf -0.999 = %a\\n\", (double)lgammaf(-0.999f));\n    printf(\"tgammaf 0.5 = %a\\n\",    (double)tgammaf(0.5f));\n    printf(\"tgammaf -0.5 = %a\\n\",   (double)tgammaf(-0.5f));\n    printf(\"tgammaf 2.5 = %a\\n\",    (double)tgammaf(2.5f));\n}\n\n/* ---- Bessel j0, j1, jn ---- */\nstatic void test_j0_extra2(void)\n{\n    printf(\"j0 0.5 = %a\\n\",   j0(0.5));\n    printf(\"j0 3.0 = %a\\n\",   j0(3.0));\n    printf(\"j0 5.0 = %a\\n\",   j0(5.0));\n    printf(\"j0 8.0 = %a\\n\",   j0(8.0));\n    printf(\"j0 10.0 = %a\\n\",  j0(10.0));\n    printf(\"j0 100.0 = %a\\n\", j0(100.0));\n    printf(\"j0 1e-5 = %a\\n\",  j0(1.0e-5));\n}\n\nstatic void test_j1_extra2(void)\n{\n    printf(\"j1 0.5 = %a\\n\",   j1(0.5));\n    printf(\"j1 3.0 = %a\\n\",   j1(3.0));\n    printf(\"j1 5.0 = %a\\n\",   j1(5.0));\n    printf(\"j1 8.0 = %a\\n\",   j1(8.0));\n    printf(\"j1 10.0 = %a\\n\",  j1(10.0));\n    printf(\"j1 100.0 = %a\\n\", j1(100.0));\n    printf(\"j1 1e-5 = %a\\n\",  j1(1.0e-5));\n}\n\nstatic void test_jn_extra2(void)\n{\n    printf(\"jn 0 0.5 = %a\\n\",   jn(0, 0.5));\n    printf(\"jn 1 0.5 = %a\\n\",   jn(1, 0.5));\n    printf(\"jn 5 0.5 = %a\\n\",   jn(5, 0.5));\n    printf(\"jn 5 10 = %a\\n\",    jn(5, 10.0));\n    printf(\"jn 10 5 = %a\\n\",    jn(10, 5.0));\n    printf(\"jn 50 10 = %a\\n\",   jn(50, 10.0));\n    printf(\"jn 2 0.01 = %a\\n\",  jn(2, 0.01));\n    printf(\"jn 3 100 = %a\\n\",   jn(3, 100.0));\n    printf(\"jn 0 100 = %a\\n\",   jn(0, 100.0));\n    printf(\"jn 1 1e-10 = %a\\n\", jn(1, 1.0e-10));\n    printf(\"jn 2 1e-10 = %a\\n\", jn(2, 1.0e-10));\n    printf(\"jn 100 1 = %a\\n\",   jn(100, 1.0));\n}\n\n/* ---- Bessel y0, y1, yn ---- */\nstatic void test_y0_extra2(void)\n{\n    printf(\"y0 0.5 = %a\\n\",   y0(0.5));\n    printf(\"y0 3.0 = %a\\n\",   y0(3.0));\n    printf(\"y0 5.0 = %a\\n\",   y0(5.0));\n    printf(\"y0 8.0 = %a\\n\",   y0(8.0));\n    printf(\"y0 10.0 = %a\\n\",  y0(10.0));\n    printf(\"y0 100.0 = %a\\n\", y0(100.0));\n    printf(\"y0 1e-5 = %a\\n\",  y0(1.0e-5));\n}\n\nstatic void test_y1_extra2(void)\n{\n    printf(\"y1 0.5 = %a\\n\",   y1(0.5));\n    printf(\"y1 3.0 = %a\\n\",   y1(3.0));\n    printf(\"y1 5.0 = %a\\n\",   y1(5.0));\n    printf(\"y1 8.0 = %a\\n\",   y1(8.0));\n    printf(\"y1 10.0 = %a\\n\",  y1(10.0));\n    printf(\"y1 100.0 = %a\\n\", y1(100.0));\n    printf(\"y1 1e-5 = %a\\n\",  y1(1.0e-5));\n}\n\nstatic void test_yn_extra2(void)\n{\n    printf(\"yn 0 0.5 = %a\\n\",  yn(0, 0.5));\n    printf(\"yn 1 0.5 = %a\\n\",  yn(1, 0.5));\n    printf(\"yn 2 0.5 = %a\\n\",  yn(2, 0.5));\n    printf(\"yn 5 10 = %a\\n\",   yn(5, 10.0));\n    printf(\"yn 10 5 = %a\\n\",   yn(10, 5.0));\n    printf(\"yn 0 100 = %a\\n\",  yn(0, 100.0));\n    printf(\"yn 1 100 = %a\\n\",  yn(1, 100.0));\n    printf(\"yn 50 10 = %a\\n\",  yn(50, 10.0));\n    printf(\"yn 3 1e-5 = %a\\n\", yn(3, 1.0e-5));\n}\n\n/* ---- pow / powf ---- */\nstatic void test_pow_extra2(void)\n{\n    union { double d; uint64_t u; } _snand, _qnand;\n    _snand.u = 0x7FF0000000000001ULL;\n    _qnand.u = 0x7FF8000000000000ULL;\n    /* pow(1, quiet NaN) → 1 */\n    printf(\"pow 1 qnan = %a\\n\",     pow(1.0, _qnand.d));\n    /* pow(quiet NaN, 0) → 1 */\n    printf(\"pow qnan 0 = %a\\n\",     pow(_qnand.d, 0.0));\n    /* pow(1, signaling NaN) → NaN */\n    printf(\"pow 1 snan = %a\\n\",     pow(1.0, _snand.d));\n    /* x<0, non-integer y → invalid */\n    printf(\"pow -2 1.5 = %a\\n\",     pow(-2.0, 1.5));\n    /* x<0, odd int y */\n    printf(\"pow -2 3 = %a\\n\",       pow(-2.0, 3.0));\n    /* x<0, even int y */\n    printf(\"pow -2 2 = %a\\n\",       pow(-2.0, 2.0));\n    /* large |y| > 2^64 */\n    printf(\"pow 2 1e20 = %a\\n\",     pow(2.0, 1.0e20));\n    printf(\"pow 0.5 1e20 = %a\\n\",   pow(0.5, 1.0e20));\n    /* |y| > 2^33: |x|<1, hy>0 → underflow */\n    printf(\"pow 0.9 1e11 = %a\\n\",   pow(0.9, 1.0e11));\n    /* |y| > 2^33: |x|>1, hy>0 → overflow */\n    printf(\"pow 1.1 1e11 = %a\\n\",   pow(1.1, 1.0e11));\n    /* special x cases */\n    printf(\"pow 0 -1 = %a\\n\",       pow(0.0, -1.0));\n    printf(\"pow -0 -1 = %a\\n\",      pow(-0.0, -1.0));\n    printf(\"pow -0 -3 = %a\\n\",      pow(-0.0, -3.0));\n    printf(\"pow -0 -2 = %a\\n\",      pow(-0.0, -2.0));\n    printf(\"pow -0 3 = %a\\n\",       pow(-0.0, 3.0));\n    printf(\"pow -0 2 = %a\\n\",       pow(-0.0, 2.0));\n    printf(\"pow -1 inf = %a\\n\",     pow(-1.0, D_INF));\n    printf(\"pow -1 -inf = %a\\n\",    pow(-1.0, D_NINF));\n    /* overflow / underflow */\n    printf(\"pow 2 1024 = %a\\n\",     pow(2.0, 1024.0));\n    printf(\"pow 0.5 -1075 = %a\\n\",  pow(0.5, -1075.0));\n    printf(\"pow 2 100 = %a\\n\",      pow(2.0, 100.0));\n    printf(\"pow 0.5 -100 = %a\\n\",   pow(0.5, -100.0));\n    /* powf */\n    union { float f; uint32_t u; } _snanf, _qnanf;\n    _snanf.u = 0x7F800001U;\n    _qnanf.u = 0x7FC00000U;\n    printf(\"powf 1 qnan = %a\\n\",    (double)powf(1.0f, _qnanf.f));\n    printf(\"powf 1 snan = %a\\n\",    (double)powf(1.0f, _snanf.f));\n    printf(\"powf -2 1.5 = %a\\n\",    (double)powf(-2.0f, 1.5f));\n    printf(\"powf -2 3 = %a\\n\",      (double)powf(-2.0f, 3.0f));\n    printf(\"powf -2 2 = %a\\n\",      (double)powf(-2.0f, 2.0f));\n    printf(\"powf 2 200 = %a\\n\",     (double)powf(2.0f, 200.0f));\n    printf(\"powf 0.5 -200 = %a\\n\",  (double)powf(0.5f, -200.0f));\n    printf(\"powf 0 -1 = %a\\n\",      (double)powf(0.0f, -1.0f));\n    printf(\"powf -0 -3 = %a\\n\",     (double)powf(-0.0f, -3.0f));\n    printf(\"powf 0.9 1e11 = %a\\n\",  (double)powf(0.9f, 1.0e11f));\n    printf(\"powf 1.1 1e11 = %a\\n\",  (double)powf(1.1f, 1.0e11f));\n    printf(\"powf 2 127 = %a\\n\",     (double)powf(2.0f, 127.0f));\n}\n\n/* ------------------------------------------------------------------ */\n/* Long double and nexttoward — conditionally compiled                 */\n/* ------------------------------------------------------------------ */\n\n#ifdef __LIBMCS_LONG_DOUBLE_IS_64BITS\n\nstatic void test_long_double_trig(void)\n{\n    printf(\"acosl %La = %La\\n\", (long double)0.5, acosl((long double)0.5));\n    printf(\"asinl %La = %La\\n\", (long double)0.5, asinl((long double)0.5));\n    printf(\"atanl %La = %La\\n\", (long double)1.0, atanl((long double)1.0));\n    printf(\"atan2l %La %La = %La\\n\", (long double)1.0, (long double)1.0,\n           atan2l((long double)1.0, (long double)1.0));\n    printf(\"cosl %La = %La\\n\", (long double)1.0, cosl((long double)1.0));\n    printf(\"sinl %La = %La\\n\", (long double)1.0, sinl((long double)1.0));\n    printf(\"tanl %La = %La\\n\", (long double)0.5, tanl((long double)0.5));\n}\n\nstatic void test_long_double_hyperbolic(void)\n{\n    printf(\"acoshl %La = %La\\n\", (long double)2.0, acoshl((long double)2.0));\n    printf(\"asinhl %La = %La\\n\", (long double)1.0, asinhl((long double)1.0));\n    printf(\"atanhl %La = %La\\n\", (long double)0.5, atanhl((long double)0.5));\n    printf(\"coshl %La = %La\\n\", (long double)1.0, coshl((long double)1.0));\n    printf(\"sinhl %La = %La\\n\", (long double)1.0, sinhl((long double)1.0));\n    printf(\"tanhl %La = %La\\n\", (long double)1.0, tanhl((long double)1.0));\n}\n\nstatic void test_long_double_exp_log(void)\n{\n    printf(\"expl %La = %La\\n\", (long double)1.0, expl((long double)1.0));\n    printf(\"exp2l %La = %La\\n\", (long double)2.0, exp2l((long double)2.0));\n    printf(\"expm1l %La = %La\\n\", (long double)1.0, expm1l((long double)1.0));\n    int e;\n    long double m = frexpl((long double)4.0, &e);\n    printf(\"frexpl %La = %La exp %d\\n\", (long double)4.0, m, e);\n    printf(\"ilogbl %La = %d\\n\", (long double)2.0, ilogbl((long double)2.0));\n    printf(\"ldexpl %La %d =