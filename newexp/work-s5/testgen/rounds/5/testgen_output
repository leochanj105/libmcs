/* log branches */\nstatic void test_log_s5(void)\n{\n    printf(\"=== test_log_s5 ===\\n\");\n    /* logd: k==0 and f==0 (x near 1.0, no exponent shift) */\n    printf(\"log(1.0) = %a\\n\", log(1.0));\n    /* logd: |f|<2^-20, f!=0 */\n    printf(\"log(1.0+1e-7) = %a\\n\", log(1.0 + 1e-7));\n    /* logd: k != 0 */\n    printf(\"log(2.0) = %a\\n\", log(2.0));\n    printf(\"log(0.5) = %a\\n\", log(0.5));\n    /* logd: x = 1.0 (k=0, f=0) */\n    printf(\"log(1.0000000001) = %a\\n\", log(1.0000000001));\n    /* log10d: k=0, f!=0 near 1 */\n    printf(\"log10(1.0+1e-7) = %a\\n\", log10(1.0 + 1e-7));\n    /* log10d: subnormal x */\n    printf(\"log10(5e-324) = %a\\n\", log10(D_SUBNORM));\n    /* log2d: k=0, f near 0 */\n    printf(\"log2(1.0+1e-7) = %a\\n\", log2(1.0 + 1e-7));\n    /* log1pd: k!=0, correction term */\n    printf(\"log1p(0.5) = %a\\n\", log1p(0.5));\n    printf(\"log1p(2.0) = %a\\n\", log1p(2.0));\n    printf(\"log1p(1e30) = %a\\n\", log1p(1e30));\n    /* log1pd: f==0 large x (k large, hu=0 region) */\n    printf(\"log1p(1e15) = %a\\n\", log1p(1e15));\n    /* log1pf */\n    printf(\"log1pf(0.5f) = %a\\n\", log1pf(0.5f));\n    printf(\"log1pf(2.0f) = %a\\n\", log1pf(2.0f));\n    printf(\"log1pf(1e8f) = %a\\n\", log1pf(1e8f));\n    /* logf: k=0, f=0 */\n    printf(\"logf(1.0f) = %a\\n\", logf(1.0f));\n    printf(\"logf(1.0f+1e-7f) = %a\\n\", logf(1.0f + 1e-7f));\n    printf(\"logf(2.0f) = %a\\n\", logf(2.0f));\n}\n\n/* modfd/modff — branches for different exponent ranges */\nstatic void test_modf_s5(void)\n{\n    printf(\"=== test_modf_s5 ===\\n\");\n    double ip;\n    float ipf;\n    /* j0 < 0: |x| < 1 */\n    printf(\"modf(0.5) = %a\\n\", modf(0.5, &ip));\n    printf(\"modf(-0.5) = %a\\n\", modf(-0.5, &ip));\n    printf(\"modf(0.0) = %a\\n\", modf(0.0, &ip));\n    printf(\"modf(-0.0) = %a\\n\", modf(-0.0, &ip));\n    /* j0 in [0,20): integral */\n    printf(\"modf(4.0) = %a\\n\", modf(4.0, &ip));\n    printf(\"modf(-4.0) = %a\\n\", modf(-4.0, &ip));\n    