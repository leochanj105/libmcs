(\"sin 1e14 = %a\\n\",   sin(1.0e14));\n    printf(\"sin 1e16 = %a\\n\",   sin(1.0e16));\n    printf(\"sin 1e50 = %a\\n\",   sin(1.0e50));\n    printf(\"cos 1e50 = %a\\n\",   cos(1.0e50));\n    /* float range reduction */\n    printf(\"sinf 1e6 = %a\\n\",   (double)sinf(1.0e6f));\n    printf(\"cosf 1e6 = %a\\n\",   (double)cosf(1.0e6f));\n    printf(\"sinf 1e20 = %a\\n\",  (double)sinf(1.0e20f));\n    printf(\"cosf 1e20 = %a\\n\",  (double)cosf(1.0e20f));\n    printf(\"sinf 1e10 = %a\\n\",  (double)sinf(1.0e10f));\n    printf(\"cosf -1e6 = %a\\n\",  (double)cosf(-1.0e6f));\n    printf(\"sinf -1e6 = %a\\n\",  (double)sinf(-1.0e6f));\n    printf(\"sinf 1e8 = %a\\n\",   (double)sinf(1.0e8f));\n}\n\n/* ---- csqrt: negative imaginary paths ---- */\nstatic void test_csqrt_extra2(void)\n{\n    double complex zd, wd;\n    float complex zf, wf;\n    /* x==0, y < 0 → (76:13) False */\n    zd = CMPLX(0.0, -4.0);\n    wd = csqrt(zd);\n    printf(\"csqrt 0-4i = %a+%ai\\n\", creal(wd), cimag(wd));\n    zd = CMPLX(0.0, -1.0);\n    wd = csqrt(zd);\n    printf(\"csqrt 0-1i = %a+%ai\\n\", creal(wd), cimag(wd));\n    /* general path, y < 0 → (109:9) True */\n    zd = CMPLX(4.0, -2.0);\n    wd = csqrt(zd);\n    printf(\"csqrt 4-2i = %a+%ai\\n\", creal(wd), cimag(wd));\n    zd = CMPLX(1.0, -3.0);\n    wd = csqrt(zd);\n    printf(\"csqrt 1-3i = %a+%ai\\n\", creal(wd), cimag(wd));\n    /* csqrtf: x==0, y < 0 → (34:13) False */\n    zf = CMPLXF(0.0f, -4.0f);\n    wf = csqrtf(zf);\n    printf(\"csqrtf 0-4i = %a+%ai\\n\", (double)crealf(wf), (double)cimagf(wf));\n    /* csqrtf: y < 0 → (67:9) True */\n    zf = CMPLXF(4.0f, -2.0f);\n    wf = csqrtf(zf);\n    printf(\"csqrtf 4-2i = %a+%ai\\n\", (double)crealf(wf), (double)cimagf(wf));\n    zf = CMPLXF(1.0f, -3.0f);\n    wf = csqrtf(zf);\n    printf(\"csqrtf 1-3i = %a+%ai\\n\", (double)crealf(wf), (double)cimagf(wf));\n}\n\n/* ---- ctan: d near 0 and large imaginary ---- */\nstatic void test_ctan_extra2(void)\n{\n    double complex zd, wd;\n   