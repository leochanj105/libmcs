pio2f(1e10f, yf);\n    printf(\"__rem_pio2f(1e10) n=%d y0=%a\\n\", n, yf[0]);\n    /* via sinf/cosf/tanf */\n    printf(\"sinf(0.5f) = %a\\n\", sinf(0.5f));\n    printf(\"cosf(0.5f) = %a\\n\", cosf(0.5f));\n    printf(\"tanf(0.5f) = %a\\n\", tanf(0.5f));\n    printf(\"sinf(1e5f) = %a\\n\", sinf(1e5f));\n    printf(\"cosf(1e5f) = %a\\n\", cosf(1e5f));\n    printf(\"sinf(1e8f) = %a\\n\", sinf(1e8f));\n    printf(\"cosf(1e8f) = %a\\n\", cosf(1e8f));\n}\n\n/* erf/erfc/erff/erfcf — additional branches */\nstatic void test_erf_s5(void)\n{\n    printf(\"=== test_erf_s5 ===\\n\");\n    /* erfd: |x| < 0.84375 */\n    printf(\"erf(0.5) = %a\\n\", erf(0.5));\n    printf(\"erf(0.8) = %a\\n\", erf(0.8));\n    /* erfd: 0.84375 <= |x| < 1.25 */\n    printf(\"erf(1.0) = %a\\n\", erf(1.0));\n    printf(\"erf(-1.0) = %a\\n\", erf(-1.0));\n    printf(\"erf(1.2) = %a\\n\", erf(1.2));\n    /* erfd: |x| >= 6 */\n    printf(\"erf(6.0) = %a\\n\", erf(6.0));\n    printf(\"erf(-6.0) = %a\\n\", erf(-6.0));\n    printf(\"erf(10.0) = %a\\n\", erf(10.0));\n    /* erfd: 1/0.35 boundary */\n    printf(\"erf(2.5) = %a\\n\", erf(2.5));\n    printf(\"erf(3.5) = %a\\n\", erf(3.5));\n    /* erfcd: positive x, small erfc */\n    printf(\"erfc(1.25) = %a\\n\", erfc(1.25));\n    printf(\"erfc(2.0) = %a\\n\", erfc(2.0));\n    /* erfcd: large positive → ~0 */\n    printf(\"erfc(28.0) = %a\\n\", erfc(28.0));\n    /* erfcd: large negative → ~2 */\n    printf(\"erfc(-28.0) = %a\\n\", erfc(-28.0));\n    /* erff: |x| < 0.84375 */\n    printf(\"erff(0.5f) = %a\\n\", erff(0.5f));\n    /* erff: |x| >= 4 */\n    printf(\"erff(4.0f) = %a\\n\", erff(4.0f));\n    printf(\"erff(-4.0f) = %a\\n\", erff(-4.0f));\n    /* erff: 1/0.35 boundary */\n    printf(\"erff(2.5f) = %a\\n\", erff(2.5f));\n    printf(\"erff(3.5f) = %a\\n\", erff(3.5f));\n    /* erfcf: 0.84375 <= |x| < 1.25 */\n    printf(\"erfcf(1.0f) = %a\\n\", erfcf(1.0f));\n    printf(\"erfcf(-1.0f) = %a\\n\", erfcf(-1.0f));\n    /* erfcf: |x| < 1/0.35, negative x near -6 */\n    printf(\"erfcf(-5.5f) = %a\\n\", erfcf(-5.5f));\n    /* erfcf: |x| >= 10.125, positive → ~0 */\n    printf(\"erfcf(11.0f) = %a\\n\", erfcf(11.0f));\n    /* erfcf: |x| >= 10.125, negative → ~2 */\n    printf(\"erfcf(-11.0f) = %a\\n\", erfcf(-11.0f));\n}\n\n/* expm1d/expm1f — specific k paths */\nstatic void test_expm1_s5(void)\n{\n    printf(\"=== test_expm1_s5 ===\\n\");\n    /* k = -1 path */\n    printf(\"expm1(-0.6) = %a\\n\", expm1(-0.6));\n    printf(\"expm1(-0.9) = %a\\n\", expm1(-0.9));\n    /* k = 1 path */\n    printf(\"expm1(0.8) = %a\\n\", expm1(0.8));\n    printf(\"expm1(0.95) = %a\\n\", expm1(0.95));\n    /* k = 1, x < -0.25 */\n    printf(\"expm1(0.65) = %a\\n\", expm1(0.65));\n    /* k <= -2 (large negative) */\n    printf(\"expm1(-2.0) = %a\\n\", expm1(-2.0));\n    printf(\"expm1(-5.0) = %a\\n\", expm1(-5.0));\n    /* k > 56 */\n    printf(\"expm1(60.0) = %a\\n\", expm1(60.0));\n    printf(\"expm1(100.0) = %a\\n\", expm1(100.0));\n    /* k < 20 */\n    printf(\"expm1(10.0) = %a\\n\", expm1(10.0));\n    printf(\"expm1(15.0) = %a\\n\", expm1(15.0));\n    /* k >= 20 */\n    printf(\"expm1(20.0) = %a\\n\", expm1(20.0));\n    printf(\"expm1(30.0) = %a\\n\", expm1(30.0));\n    /* tiny */\n    printf(\"expm1(1e-20) = %a\\n\", expm1(1e-20));\n    /* x < -56*ln2 */\n    printf(\"expm1(-50.0) = %a\\n\", expm1(-50.0));\n    /* expm1f similar */\n    printf(\"expm1f(-0.6f) = %a\\n\", expm1f(-0.6f));\n    printf(\"expm1f(0.8f) = %a\\n\", expm1f(0.8f));\n    printf(\"expm1f(-2.0f) = %a\\n\", expm1f(-2.0f));\n    printf(\"expm1f(60.0f) = %a\\n\", expm1f(60.0f));\n    printf(\"expm1f(10.0f) = %a\\n\", expm1f(10.0f));\n    printf(\"expm1f(25.0f) = %a\\n\", expm1f(25.0f));\n    printf(\"expm1f(1e-10f) = %a\\n\", expm1f(1e-10f));\n}\n\n/* ctand/ctanf — d==0 branch and |d|<0.25 branch */\nstatic void test_ctan_s5(void)\n{\n    printf(\"=== test_ctan_s5 ===\\n\");\n    /* ctand: |d|<0.25 path — near pole, use __ctans */\n    double complex zd;\n    /* re=pi/2 (near pole): cos(2*re)~0, cosh(2*im)~1, d~0 */\n    zd = CMPLX(1.5707963267948966, 0.1);\n    printf(\"ctan(pi/2+0.1i) = %a+%ai\\n\", creal(ctan(zd)), cimag(ctan(zd)));\n    zd = CMPLX(1.5707963267948966, 0.05);\n    printf(\"ctan(pi/2+0.05i) = %a+%ai\\n\", creal(ctan(zd)), cimag(ctan(zd)));\n    /* ctand: large imaginary → d near 0 */\n    zd = CMPLX(0.0, 50.0);\n    printf(\"ctan(0+50i) = %a+%ai\\n\", creal(ctan(zd)), cimag(ctan(zd)));\n    /* ctanf similar */\n    float complex zf;\n    zf = CMPLXF(1.5707963f, 0.1f);\n    printf(\"ctanf(pi/2+0.1i) = %a+%ai\\n\", crealf(ctanf(zf)), cimagf(ctanf(zf)));\n    zf = CMPLXF(1.5707963f, 0.05f);\n    printf(\"ctanf(pi/2+0.05i) = %a+%ai\\n\", crealf(ctanf(zf)), cimagf(ctanf(zf)));\n    zf = CMPLXF(0.0f, 50.0f);\n    printf(\"ctanf(0+50i) = %a+%ai\\n\", crealf(ctanf(zf)), cimagf(ctanf(zf)));\n    /* ctrigf/__ccoshsinhf: |x|>0.5, exp(x)=0 for very negative x */\n    float c, s;\n    __ccoshsinhf(-200.0f, &c, &s);\n    printf(\"__ccoshsinhf(-200) c=%a s=%a\\n\", c, s);\n    __ccoshsinhf(200.0f, &c, &s);\n    printf(\"__ccoshsinhf(200) c=%a s=%a\\n\", c, s);\n    /* __redupif: t<0 path */\n    printf(\"__redupif(-3.14f) = %a\\n\", __redupif(-3.14f));\n    printf(\"__redupif(-6.28f) = %a\\n\", __redupif(-6.28f));\n    /* ctrigf complex sin/cos with large imaginary */\n    float complex zfc = CMPLXF(1.0f, 10.0f);\n    printf(\"csinf(1+10i) = %a+%ai\\n\", crealf(csinf(zfc)), cimagf(csinf(zfc)));\n    printf(\"ccosf(1+10i) = %a+%ai\\n\", crealf(ccosf(zfc)), cimagf(ccosf(zfc)));\n    /* large real in ctrigf: __rem_pio2f through ccoshsinhf */\n    float complex zfb = CMPLXF(100.0f, 0.5f);\n    printf(\"csinf(100+0.5i) = %a+%ai\\n\", crealf(csinf(zfb)), cimagf(csinf(zfb)));\n    printf(\"ccosf(100+0.5i) = %a+%ai\\n\", crealf(ccosf(zfb)), cimagf(ccosf(zfb)));\n}","originalFile":"/* test_suite.c — comprehensive test suite for libmcs math library.\n * Tests all public and bridged-static functions.\n * Results printed in %a hex float format for bitwise comparison.\n */\n\n#include <stdio.h>\n#include <stdint.h>\n#include <math.h>\n#include <complex.h>\n#include \"test_bridge.h\"\n\n/* Internal function declarations not in public headers */\nextern double __sin(double x, double y, int iy);\nextern double __cos(double x, double y);\nextern int32_t __rem_pio2(double x, double *y);\nextern float __sinf(float x, float y, int iy);\nextern float __cosf(float x, float y);\nextern int32_t __rem_pio2f(float x, float *y);\nextern void __ccoshsinh(double x, double *c, double *s);\nextern double __redupi(double x);\nextern void __ccoshsinhf(float x, float *c, float *s);\nextern float __redupif(float x);\nextern double __lgamma(double x, int *signgamp);\nextern float __lgammaf(float x, int *signgamp);\nextern int __fpclassifyd(double x);\nextern int __fpclassifyf(float x);\nextern int __signbitd(double x);\nextern int __signbitf(float x);\n\n/* ------------------------------------------------------------------ */\n/* Trigonometric functions — double                                    */\n/* ------------------------------------------------------------------ */\n\nstatic void test_acos(void)\n{\n    printf(\"acos %a = %a\\n\", 0.5, acos(0.5));\n    printf(\"acos %a = %a\\n\", 0.0, acos(0.0));\n    printf(\"acos %a = %a\\n\", 1.0, acos(1.0));\n    printf(\"acos %a = %a\\n\", -1.0, acos(-1.0));\n}\n\nstatic void test_asin(void)\n{\n    printf(\"asin %a = %a\\n\", 0.5, asin(0.5));\n    printf(\"asin %a = %a\\n\", 0.0, asin(0.0));\n    printf(\"asin %a = %a\\n\", 1.0, asin(1.0));\n    printf(\"asin %a = %a\\n\", -0.5, asin(-0.5));\n}\n\nstatic void test_atan(void)\n{\n    printf(\"atan %a = %a\\n\", 1.0, atan(1.0));\n    printf(\"atan %a = %a\\n\", 0.0, atan(0.0));\n    printf(\"atan %a = %a\\n\", -1.0, atan(-1.0));\n}\n\nstatic void test_atan2(void)\n{\n    printf(\"atan2 %a %a = %a\\n\", 1.0, 1.0, atan2(1.0, 1.0));\n    printf(\"atan2 %a %a = %a\\n\", 0.0, 1.0, atan2(0.0, 1.0));\n    printf(\"atan2 %a %a = %a\\n